        <ResourceInclude Source="avares://WiiStudio.App/Styles/tokens/Grid.axaml" />
        <ResourceInclude Source="avares://WiiStudio.App/Styles/tokens/Breakpoints.axaml" />
        <ResourceInclude Source="avares://WiiStudio.App/Styles/tokens/Responsive.axaml" />
        <ResourceInclude Source="avares://WiiStudio.App/Styles/tokens/Radius.axaml" />
        <ResourceInclude Source="avares://WiiStudio.App/Styles/tokens/Elevation.axaml" />
        <ResourceInclude Source="avares://WiiStudio.App/Styles/icons/IconTokens.axaml" />
