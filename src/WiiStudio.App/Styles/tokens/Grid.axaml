<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:Double x:Key="WiiGridGutter">16</sys:Double>
  <sys:Double x:Key="WiiGridDenseGutter">12</sys:Double>
  <sys:Double x:Key="WiiGridWideGutter">24</sys:Double>
</ResourceDictionary>
