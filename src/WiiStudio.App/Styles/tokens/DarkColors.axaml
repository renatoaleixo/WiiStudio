<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WiiDarkColorPrimary">#6EA8FF</Color>
  <Color x:Key="WiiDarkColorPrimaryHover">#8BB9FF</Color>
  <Color x:Key="WiiDarkColorPrimaryPressed">#4F8FF0</Color>
  <Color x:Key="WiiDarkColorSecondary">#9BA8BA</Color>
  <Color x:Key="WiiDarkColorSecondaryHover">#C7CEDA</Color>
  <Color x:Key="WiiDarkColorAccent">#38BDF8</Color>
  <Color x:Key="WiiDarkColorBackground">#101319</Color>
  <Color x:Key="WiiDarkColorChrome">#1A1F28</Color>
  <Color x:Key="WiiDarkColorSidebar">#151922</Color>
  <Color x:Key="WiiDarkColorSurface">#171C25</Color>
  <Color x:Key="WiiDarkColorSurfaceAlt">#141820</Color>
  <Color x:Key="WiiDarkColorSurfaceRaised">#202632</Color>
  <Color x:Key="WiiDarkColorBorder">#242B36</Color>
  <Color x:Key="WiiDarkColorTextPrimary">#F6F8FC</Color>
  <Color x:Key="WiiDarkColorTextSecondary">#C7CEDA</Color>
  <Color x:Key="WiiDarkColorTextMuted">#8EA0B8</Color>
  <Color x:Key="WiiDarkColorTextInverted">#101319</Color>
  <Color x:Key="WiiDarkColorSuccess">#7BD88F</Color>
  <Color x:Key="WiiDarkColorSuccessHover">#A7F3D0</Color>
  <Color x:Key="WiiDarkColorWarning">#FBBF24</Color>
  <Color x:Key="WiiDarkColorError">#F87171</Color>
  <Color x:Key="WiiDarkColorErrorHover">#FCA5A5</Color>
  <Color x:Key="WiiDarkColorInfo">#7DD3FC</Color>
  <Color x:Key="WiiDarkColorDisabled">#536174</Color>
  <Color x:Key="WiiDarkColorFocus">#93C5FD</Color>
</ResourceDictionary>
