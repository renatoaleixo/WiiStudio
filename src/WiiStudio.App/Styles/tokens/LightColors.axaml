<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WiiLightColorPrimary">#2563EB</Color>
  <Color x:Key="WiiLightColorPrimaryHover">#1D4ED8</Color>
  <Color x:Key="WiiLightColorPrimaryPressed">#1E40AF</Color>
  <Color x:Key="WiiLightColorSecondary">#64748B</Color>
  <Color x:Key="WiiLightColorSecondaryHover">#475569</Color>
  <Color x:Key="WiiLightColorAccent">#0EA5E9</Color>
  <Color x:Key="WiiLightColorBackground">#F5F7FB</Color>
  <Color x:Key="WiiLightColorChrome">#FFFFFF</Color>
  <Color x:Key="WiiLightColorSidebar">#EEF2F7</Color>
  <Color x:Key="WiiLightColorSurface">#FFFFFF</Color>
  <Color x:Key="WiiLightColorSurfaceAlt">#E8EEF6</Color>
  <Color x:Key="WiiLightColorSurfaceRaised">#FFFFFF</Color>
  <Color x:Key="WiiLightColorBorder">#CBD5E1</Color>
  <Color x:Key="WiiLightColorTextPrimary">#172033</Color>
  <Color x:Key="WiiLightColorTextSecondary">#475569</Color>
  <Color x:Key="WiiLightColorTextMuted">#64748B</Color>
  <Color x:Key="WiiLightColorTextInverted">#FFFFFF</Color>
  <Color x:Key="WiiLightColorSuccess">#15803D</Color>
  <Color x:Key="WiiLightColorSuccessHover">#166534</Color>
  <Color x:Key="WiiLightColorWarning">#B45309</Color>
  <Color x:Key="WiiLightColorError">#DC2626</Color>
  <Color x:Key="WiiLightColorErrorHover">#B91C1C</Color>
  <Color x:Key="WiiLightColorInfo">#0369A1</Color>
  <Color x:Key="WiiLightColorDisabled">#94A3B8</Color>
  <Color x:Key="WiiLightColorFocus">#60A5FA</Color>
  <Color x:Key="WiiLightColorScrim">#66000000</Color>
</ResourceDictionary>
