<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="WiiFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  <FontFamily x:Key="WiiCodeFontFamily">Consolas, Cascadia Mono, monospace</FontFamily>

  <sys:Double x:Key="WiiLineHeightDisplay">36</sys:Double>
  <sys:Double x:Key="WiiLineHeightHeading">32</sys:Double>
  <sys:Double x:Key="WiiLineHeightTitle">28</sys:Double>
  <sys:Double x:Key="WiiLineHeightSubtitle">24</sys:Double>
  <sys:Double x:Key="WiiLineHeightBody">20</sys:Double>
  <sys:Double x:Key="WiiLineHeightCaption">16</sys:Double>
  <sys:Double x:Key="WiiLineHeightCode">18</sys:Double>
</ResourceDictionary>
