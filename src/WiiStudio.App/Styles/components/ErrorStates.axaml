<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.partialErrorState">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushWarning}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusLarge}" />
    <Setter Property="Padding" Value="{StaticResource WiiStatePadding}" />
  </Style>
</Styles>
