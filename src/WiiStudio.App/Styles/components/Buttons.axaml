<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{StaticResource WiiInteractiveTargetMin}" />
    <Setter Property="Padding" Value="{StaticResource WiiButtonPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushTextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource WiiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource WiiFontSizeBody}" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WiiBrushPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushPrimaryHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource WiiBrushTextPrimary}" />
  </Style>

  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WiiBrushPrimaryHover}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.56" />
  </Style>
</Styles>
