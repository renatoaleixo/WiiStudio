<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.toast">
    <Setter Property="Width" Value="{StaticResource WiiToastWidth}" />
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Padding" Value="{StaticResource WiiToastPadding}" />
    <Setter Property="BoxShadow" Value="{StaticResource WiiShadowMedium}" />
  </Style>

  <Style Selector="Border.toast.error">
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushError}" />
  </Style>

  <Style Selector="Border.toast.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushWarning}" />
  </Style>

  <Style Selector="Border.toast.success">
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushSuccess}" />
  </Style>
</Styles>
