<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.helpHint">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushInfo}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Padding" Value="{StaticResource WiiHelpHintPadding}" />
  </Style>

  <Style Selector="TextBlock.helpHintText">
    <Setter Property="FontSize" Value="{StaticResource WiiFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushTextSecondary}" />
  </Style>
</Styles>
