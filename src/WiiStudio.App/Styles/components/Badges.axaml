<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.badge">
    <Setter Property="MinHeight" Value="{StaticResource WiiBadgeMinHeight}" />
    <Setter Property="Padding" Value="{StaticResource WiiBadgePadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.badgeText">
    <Setter Property="FontSize" Value="{StaticResource WiiFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushTextPrimary}" />
    <Setter Property="FontWeight" Value="{StaticResource WiiFontWeightSemiBold}" />
  </Style>
</Styles>
