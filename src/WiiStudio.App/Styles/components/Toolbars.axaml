<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource WiiBrushChrome}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="{StaticResource WiiToolbarHeight}" />
    <Setter Property="Padding" Value="{StaticResource WiiToolbarPadding}" />
  </Style>

  <Style Selector="StackPanel.toolbarGroup">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{StaticResource WiiSpace8}" />
    <Setter Property="Margin" Value="{StaticResource WiiToolbarGroupMargin}" />
  </Style>

  <Style Selector="Border.toolbarSeparator">
    <Setter Property="Width" Value="{StaticResource WiiToolbarSeparatorWidth}" />
    <Setter Property="Height" Value="{StaticResource WiiToolbarSeparatorHeight}" />
    <Setter Property="Background" Value="{DynamicResource WiiBrushBorder}" />
  </Style>
</Styles>
