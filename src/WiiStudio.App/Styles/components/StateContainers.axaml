<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.emptyState">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusLarge}" />
    <Setter Property="Padding" Value="{StaticResource WiiDialogPadding}" />
  </Style>

  <Style Selector="Border.errorState">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushError}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusLarge}" />
    <Setter Property="Padding" Value="{StaticResource WiiDialogPadding}" />
  </Style>

  <Style Selector="Border.loadingState">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushInfo}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusLarge}" />
    <Setter Property="Padding" Value="{StaticResource WiiDialogPadding}" />
  </Style>
</Styles>
