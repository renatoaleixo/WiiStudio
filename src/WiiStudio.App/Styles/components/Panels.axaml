<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.sidePanel">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="{StaticResource WiiPanelPadding}" />
  </Style>

  <Style Selector="StackPanel.panelContent">
    <Setter Property="Spacing" Value="{StaticResource WiiSpace16}" />
  </Style>
</Styles>
