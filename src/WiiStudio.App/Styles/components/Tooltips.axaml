<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusSmall}" />
    <Setter Property="Padding" Value="{StaticResource WiiTooltipPadding}" />
    <Setter Property="MaxWidth" Value="{StaticResource WiiTooltipMaxWidth}" />
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushTextPrimary}" />
  </Style>
</Styles>
