<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.container">
    <Setter Property="Background" Value="{DynamicResource WiiBrushBackground}" />
    <Setter Property="Padding" Value="{StaticResource WiiPagePadding}" />
  </Style>

  <Style Selector="Border.contentBlock">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Padding" Value="{StaticResource WiiPanelPadding}" />
  </Style>
</Styles>
