<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ListBox.navigation">
    <Setter Property="Background" Value="{DynamicResource WiiBrushTransparent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.navigationItem">
    <Setter Property="MinHeight" Value="{StaticResource WiiNavigationItemHeight}" />
    <Setter Property="Padding" Value="{StaticResource WiiNavigationItemPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Background" Value="{DynamicResource WiiBrushTransparent}" />
  </Style>

  <Style Selector="Border.navigationItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurface}" />
  </Style>

  <Style Selector="Border.navigationItem.active">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushPrimary}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>

  <Style Selector="TextBlock.navigationGroup">
    <Setter Property="FontSize" Value="{StaticResource WiiFontSizeCaption}" />
    <Setter Property="FontWeight" Value="{StaticResource WiiFontWeightSemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushTextMuted}" />
    <Setter Property="Margin" Value="{StaticResource WiiNavigationGroupMargin}" />
  </Style>
</Styles>
