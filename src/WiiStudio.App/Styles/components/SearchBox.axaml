<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBox.searchBox">
    <Setter Property="MinWidth" Value="{StaticResource WiiSearchBoxMinWidth}" />
    <Setter Property="MinHeight" Value="{StaticResource WiiInputHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusPill}" />
  </Style>
</Styles>
