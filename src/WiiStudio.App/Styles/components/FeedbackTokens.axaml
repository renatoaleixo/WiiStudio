<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:Double x:Key="WiiToastWidth">360</sys:Double>
  <Thickness x:Key="WiiToastPadding">16</Thickness>
  <Thickness x:Key="WiiFeedbackStackMargin">24</Thickness>
</ResourceDictionary>
