<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.metricTile">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Padding" Value="{StaticResource WiiCardPadding}" />
    <Setter Property="MinHeight" Value="{StaticResource WiiTileMinHeight}" />
  </Style>

  <Style Selector="TextBlock.metricValue">
    <Setter Property="FontSize" Value="{StaticResource WiiFontSizeTitle}" />
    <Setter Property="FontWeight" Value="{StaticResource WiiFontWeightSemiBold}" />
  </Style>
</Styles>
