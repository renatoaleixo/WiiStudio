<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="{StaticResource WiiProgressBarHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushPrimary}" />
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusSmall}" />
  </Style>

  <Style Selector="Border.progressBlock">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Padding" Value="{StaticResource WiiProgressBlockPadding}" />
  </Style>
</Styles>
