<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.gridState">
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Padding" Value="{StaticResource WiiPanelPadding}" />
  </Style>

  <Style Selector="Border.gridState.error">
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushError}" />
  </Style>
</Styles>
