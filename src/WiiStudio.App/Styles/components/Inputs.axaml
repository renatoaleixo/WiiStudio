<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource WiiInteractiveTargetMin}" />
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushTextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource WiiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource WiiFontSizeBody}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushFocus}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{StaticResource WiiInteractiveTargetMin}" />
    <Setter Property="Background" Value="{DynamicResource WiiBrushSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WiiBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WiiRadiusMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushTextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource WiiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource WiiFontSizeBody}" />
  </Style>
</Styles>
