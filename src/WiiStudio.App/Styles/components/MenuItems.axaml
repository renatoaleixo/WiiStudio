<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock.menuShortcut">
    <Setter Property="Foreground" Value="{DynamicResource WiiBrushTextMuted}" />
    <Setter Property="FontSize" Value="{StaticResource WiiFontSizeCaption}" />
  </Style>
</Styles>
