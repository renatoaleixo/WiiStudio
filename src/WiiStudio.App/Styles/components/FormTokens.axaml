<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:Double x:Key="WiiFormFieldMinWidth">180</sys:Double>
  <sys:Double x:Key="WiiFormFieldMaxWidth">720</sys:Double>
  <sys:Double x:Key="WiiSearchBoxMinWidth">240</sys:Double>
  <Thickness x:Key="WiiFormSectionMargin">0,0,0,24</Thickness>
  <Thickness x:Key="WiiFieldHelpMargin">0,4,0,0</Thickness>
</ResourceDictionary>
