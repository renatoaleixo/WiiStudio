<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:WiiStudio.Domain.Entities;assembly=WiiStudio.Domain"
        xmlns:dto="clr-namespace:WiiStudio.Application.DTOs;assembly=WiiStudio.Application"
        xmlns:vm="clr-namespace:WiiStudio.App.ViewModels"
        x:Class="WiiStudio.App.Views.MainWindow"
        Title="WiiStudio"
        Icon="/Assets/wiistudio.ico"
        Width="1280"
        Height="780"
        MinWidth="980"
        MinHeight="640">
  <Design.DataContext>
    <x:Null />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource WiiBrushBackground}">
    <Border Grid.Row="0" Classes="toolbar" Padding="{StaticResource WiiInsetToolbar}">
      <DockPanel LastChildFill="True">
      <Menu DockPanel.Dock="Top">
        <MenuItem Header="Arquivo">
          <MenuItem Header="Importar jogo..." Command="{Binding ExecuteShellCommandCommand}" CommandParameter="import.open" InputGesture="Ctrl+I" />
          <MenuItem Header="Exportar selecionados..." Command="{Binding ExportSelectedGamesCommand}" />
          <Separator />
          <MenuItem Header="Configurações" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.settings" InputGesture="Ctrl+," />
          <MenuItem Header="Sair" Command="{Binding ExitApplicationCommand}" InputGesture="Ctrl+Q" />
        </MenuItem>
        <MenuItem Header="Editar">
          <MenuItem Header="Copiar" Command="{Binding CopySelectionCommand}" InputGesture="Ctrl+C" />
          <MenuItem Header="Selecionar tudo" Command="{Binding SelectAllVisibleGamesCommand}" InputGesture="Ctrl+A" />
          <MenuItem Header="Limpar filtros" Command="{Binding ClearLibrarySearchCommand}" />
        </MenuItem>
        <MenuItem Header="Exibir">
          <MenuItem Header="Dashboard" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.dashboard" />
          <MenuItem Header="Biblioteca" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.library" />
          <MenuItem Header="Dispositivos" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.devices" />
          <Separator />
          <MenuItem Header="Mostrar/Ocultar painel lateral" Command="{Binding ToggleSidePanelCommand}" InputGesture="Ctrl+B" />
        </MenuItem>
        <MenuItem Header="Biblioteca">
          <MenuItem Header="Atualizar biblioteca" Command="{Binding RefreshLibraryCommand}" InputGesture="Ctrl+R" />
          <MenuItem Header="Sincronizar metadados" Command="{Binding SynchronizeSelectedMetadataCommand}" />
          <MenuItem Header="Baixar capas" Command="{Binding DownloadSelectedCoversCommand}" />
          <MenuItem Header="Remover selecionados" Command="{Binding RemoveSelectedGamesCommand}" Classes="danger" InputGesture="Delete" />
        </MenuItem>
        <MenuItem Header="Ferramentas">
          <MenuItem Header="Executar diagnóstico" Command="{Binding RunDiagnosticsCommand}" InputGesture="Ctrl+Shift+D" />
          <MenuItem Header="Abrir Command Palette" Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+Shift+P" />
        </MenuItem>
        <MenuItem Header="Plugins">
          <MenuItem Header="Gerenciar plugins" Command="{Binding ManagePluginsCommand}" />
          <MenuItem Header="Recarregar plugins" Command="{Binding ReloadPluginsCommand}" />
        </MenuItem>
        <MenuItem Header="Ajuda">
          <MenuItem Header="Documentação" Command="{Binding ShowDocumentationCommand}" />
          <MenuItem Header="Atalhos de teclado" Command="{Binding ShowKeyboardShortcutsCommand}" />
          <MenuItem Header="Sobre o WiiStudio" Command="{Binding ShowAboutCommand}" />
        </MenuItem>
      </Menu>
      <Grid ColumnDefinitions="Auto,*,320,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
        <TextBlock Text="WiiStudio"
                   FontSize="{StaticResource WiiFontSizeTitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource WiiBrushTextPrimary}"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding DetectDrivesCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Classes="primary">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Device}" />
              <TextBlock Text="Detectar HDs" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ToggleSidePanelCommand}" Classes="secondary">
            <TextBlock Text="Painel" />
          </Button>
          <TextBox Text="{Binding DockLayoutName, Mode=TwoWay}"
                   Classes="small"
                   Width="110"
                   Height="34"
                   Watermark="Layout" />
          <ComboBox ItemsSource="{Binding DockLayouts}"
                    SelectedItem="{Binding SelectedDockLayout}"
                    Width="132"
                    Height="34" />
          <Button Command="{Binding SaveDockLayoutCommand}" Classes="secondary small">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Save}" />
              <TextBlock Text="Salvar" />
            </StackPanel>
          </Button>
          <Button Command="{Binding LoadDockLayoutCommand}" Classes="secondary small">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Folder}" />
              <TextBlock Text="Carregar" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ResetDockLayoutCommand}" Classes="tertiary small" ToolTip.Tip="Restaurar layout padrão">
            <TextBlock Text="Reset" />
          </Button>
          <Button Command="{Binding OpenCommandPaletteCommand}" Classes="secondary small" ToolTip.Tip="Abrir command palette">
            <TextBlock Text="Comandos" />
          </Button>
          <ComboBox ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme}"
                    Width="120"
                    Height="34">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ThemeOptionViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Command="{Binding ApplySelectedThemeCommand}" Classes="secondary small" ToolTip.Tip="Aplicar tema selecionado">
            <TextBlock Text="Tema" />
          </Button>
        </StackPanel>

        <TextBox Grid.Column="2"
                 Classes="searchBox"
                 Watermark="Pesquisar jogos, tarefas e logs"
                 Text="{Binding LibrarySearchText, Mode=TwoWay}"
                 Height="36"
                 VerticalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   Text="Default"
                   Foreground="{DynamicResource WiiBrushTextSecondary}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="4"
                   Text="{Binding State}"
                   Foreground="{DynamicResource WiiBrushTextMuted}"
                   VerticalAlignment="Center" />
      </Grid>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="232,5,*,5,300">
      <Border Grid.Column="0" Background="{DynamicResource WiiBrushSidebar}" Padding="{StaticResource WiiInsetMd}">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top"
                     Text="Módulos"
                     Foreground="{DynamicResource WiiBrushTextMuted}"
                     FontWeight="SemiBold"
                     Margin="{StaticResource WiiSidebarHeadingMargin}" />
          <ListBox ItemsSource="{Binding Modules}"
                   Classes="navigation"
                   SelectedItem="{Binding SelectedModule}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="dto:ShellModule">
                <Border Classes="navigationItem" Margin="{StaticResource WiiModuleItemMargin}">
                  <Grid RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1"
                             Text="{Binding Description}"
                             Foreground="{DynamicResource WiiBrushTextMuted}"
                             FontSize="{StaticResource WiiFontSizeMicro}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="{DynamicResource WiiBrushBorder}" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="{StaticResource WiiWorkspaceMargin}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding SelectedModuleTitle}"
                     FontSize="{StaticResource WiiFontSizeHeading}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource WiiBrushTextPrimary}" />
          <TextBlock Text="{Binding SelectedModuleDescription}"
                     Foreground="{DynamicResource WiiBrushTextSecondary}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="{StaticResource WiiWorkspaceContentMargin}">
          <Grid IsVisible="{Binding IsDashboardModuleSelected}" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
              <ItemsControl ItemsSource="{Binding DashboardWidgets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:DashboardWidgetViewModel">
                    <Border Classes="metricTile" Margin="{StaticResource WiiDashboardCardMargin}">
                      <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextMuted}" FontWeight="SemiBold" FontSize="{StaticResource WiiFontSizeCaption}" />
                        <TextBlock Grid.Row="1" Classes="metricValue" Text="{Binding Value}" Foreground="{DynamicResource WiiBrushTextPrimary}" Margin="{StaticResource WiiMetricValueMargin}" />
                        <TextBlock Grid.Row="2" Text="{Binding Detail}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Classes="card" Padding="{StaticResource WiiInsetMd}">
                  <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Atividades" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding DashboardActivities}" MaxHeight="98" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DashboardActivityViewModel">
                          <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiListItemCompactMargin}">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="{Binding Detail}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" Padding="{StaticResource WiiInsetMd}">
                  <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Atalhos" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      <Button Grid.Column="1" Command="{Binding RefreshDashboardCommand}" Classes="icon small" ToolTip.Tip="Atualizar atalhos">
                        <PathIcon Classes="small" Data="{StaticResource WiiIcon.Refresh}" />
                      </Button>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding DashboardQuickActions}" MaxHeight="98" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DashboardQuickActionViewModel">
                          <Button Command="{Binding DataContext.RunDashboardQuickActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Classes="tertiary small" Margin="{StaticResource WiiListButtonMargin}">
                            <TextBlock Text="{Binding Title}" />
                          </Button>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <Border Grid.Row="1" Classes="contentBlock" Margin="{StaticResource WiiSectionTopMargin}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="Resumo da Biblioteca" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <TextBlock Text="{Binding LibrarySummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LibraryState}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Command="{Binding RefreshLibraryCommand}" IsEnabled="{Binding !IsBusy}" Classes="secondary small" VerticalAlignment="Center">
                  <TextBlock Text="Atualizar biblioteca" />
                </Button>
                <Button Grid.Column="3" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.library" Classes="primary small" VerticalAlignment="Center">
                  <TextBlock Text="Abrir" />
                </Button>
              </Grid>
            </Border>
          </Grid>

          <Grid IsVisible="{Binding IsLibraryModuleSelected}" RowDefinitions="Auto,Auto,*">
            <Border Classes="contentBlock">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="Biblioteca" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <TextBlock Text="{Binding LibrarySummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LibraryState}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding LibraryViewModes}" SelectedItem="{Binding SelectedLibraryViewMode}" Width="132" Height="34" VerticalAlignment="Center" />
                <Button Grid.Column="3" Command="{Binding RefreshLibraryCommand}" IsEnabled="{Binding !IsBusy}" Classes="secondary" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Refresh}" />
                    <TextBlock Text="Atualizar" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="dataGridToolbar" Margin="{StaticResource WiiSectionTopMargin}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                <TextBox Classes="searchBox" Watermark="Filtrar por título, ID ou região" Text="{Binding LibrarySearchText, Mode=TwoWay}" Height="34" />
                <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Command="{Binding ClearLibrarySearchCommand}" Classes="tertiary small" VerticalAlignment="Center">
                  <TextBlock Text="Limpar" />
                </Button>
                <Button Grid.Column="3" Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding !IsBusy}" Classes="secondary small" VerticalAlignment="Center">
                  <TextBlock Text="Dispositivos" />
                </Button>
                <Button Grid.Column="4" Command="{Binding EjectSelectedDeviceCommand}" Classes="danger small" VerticalAlignment="Center">
                  <TextBlock Text="Ejetar" />
                </Button>
              </Grid>
            </Border>

            <Grid Grid.Row="2" Classes="dataGrid" RowDefinitions="Auto,*" Margin="{StaticResource WiiSectionTopMargin}">
              <Border Classes="dataGridHeader">
                <Grid ColumnDefinitions="56,88,2*,120,110,100,90,90" ColumnSpacing="12">
                  <TextBlock Classes="dataGridHeaderText" Text="Capa" />
                  <TextBlock Classes="dataGridHeaderText" Grid.Column="1" Text="ID" />
                  <TextBlock Classes="dataGridHeaderText" Grid.Column="2" Text="Título" />
                  <TextBlock Classes="dataGridHeaderText" Grid.Column="3" Text="Região" />
                  <TextBlock Classes="dataGridHeaderText" Grid.Column="4" Text="Formato" />
                  <TextBlock Classes="dataGridHeaderText" Grid.Column="5" Text="Tamanho" />
                  <TextBlock Classes="dataGridHeaderText" Grid.Column="6" Text="Adicionado" />
                  <TextBlock Classes="dataGridHeaderText" Grid.Column="7" Text="Status" />
                </Grid>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:LibraryGameItem">
                    <Grid Classes="dataGridRow" ColumnDefinitions="56,88,2*,120,110,100,90,90" ColumnSpacing="12" Margin="{StaticResource WiiLibraryRowMargin}" MinHeight="72">
                      <Border Width="44" Height="60" CornerRadius="{StaticResource WiiRadiusSmall}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                          <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                          <TextBlock Text="--" IsVisible="{Binding !HasCover}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeCaption}" />
                        </Grid>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Grid.Column="3" Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Classes="badgeText" Text="{Binding Region}" /></Border>
                      <Border Grid.Column="4" Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Classes="badgeText" Text="{Binding Format}" /></Border>
                      <TextBlock Grid.Column="5" Text="{Binding Size}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="{Binding AddedAt}" Foreground="{DynamicResource WiiBrushTextMuted}" VerticalAlignment="Center" />
                      <Border Grid.Column="7" Classes="badge success" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Classes="badgeText" Text="{Binding Favorite}" /></Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>

          <ScrollViewer IsVisible="{Binding IsDevicesModuleSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <Border Classes="contentBlock">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <TextBlock Text="Dispositivos" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Text="{Binding DeviceManagerSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding !IsBusy}" Classes="primary small" VerticalAlignment="Center">
                    <TextBlock Text="Detectar" />
                  </Button>
                  <Button Grid.Column="2" Command="{Binding EjectSelectedDeviceCommand}" Classes="danger small" VerticalAlignment="Center">
                    <TextBlock Text="Ejetar" />
                  </Button>
                </Grid>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderThickness="0" MinHeight="260">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DeviceInfoViewModel">
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="{StaticResource WiiInsetMd}" MinHeight="72">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource WiiBrushTextMuted}" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding MountPoint}" Foreground="{DynamicResource WiiBrushTextMuted}" TextTrimming="CharacterEllipsis" />
                      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="14" Margin="{StaticResource WiiListButtonMargin}">
                        <TextBlock Text="{Binding FileSystem}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding FreeSpace}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                        <TextBlock Grid.Column="2" Text="{Binding Compatibility}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                        <TextBlock Grid.Column="3" Text="{Binding DevicePath}" Foreground="{DynamicResource WiiBrushTextMuted}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsConversionModuleSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
              <Border Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Conversão" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Grid.Column="1" Text="{Binding ConversionWizardState}" Foreground="{DynamicResource WiiBrushTextMuted}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="*,110" ColumnSpacing="8">
                    <TextBox Text="{Binding ConversionSourcePathsText, Mode=TwoWay}" Watermark="/jogos/mario.iso" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                    <Button Grid.Column="1" Classes="secondary small" Click="OnPickConversionFilesClicked" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                      <TextBlock Text="Selecionar" />
                    </Button>
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="*,160" ColumnSpacing="8">
                    <TextBox Text="{Binding ConversionDestinationDirectory, Mode=TwoWay}" Watermark="/jogos/convertidos" Height="34" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ConversionTargetFormats}" SelectedItem="{Binding SelectedConversionTargetFormat}" Height="34" />
                  </Grid>
                  <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Command="{Binding AnalyzeConversionCommand}" IsEnabled="{Binding !IsBusy}" Classes="secondary small"><TextBlock Text="Analisar" /></Button>
                    <Button Grid.Column="1" Command="{Binding ExecuteConversionCommand}" IsEnabled="{Binding CanExecuteConversion}" Classes="primary small"><TextBlock Text="Converter" /></Button>
                    <Button Grid.Column="2" Command="{Binding CancelConversionCommand}" Classes="tertiary small"><TextBlock Text="Cancelar" /></Button>
                    <TextBlock Grid.Column="3" Text="{Binding ConversionSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding ConversionPreviewItems}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderThickness="0" MinHeight="180">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ConversionPreviewItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiInsetSm}">
                      <TextBlock Text="{Binding SourcePath}" Foreground="{DynamicResource WiiBrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1" Text="{Binding Pipeline}" Foreground="{DynamicResource WiiBrushTextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsDiagnosticsModuleSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <Border Classes="contentBlock">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <TextBlock Text="Diagnóstico" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Text="{Binding DiagnosticsSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Command="{Binding RunDiagnosticsCommand}" Classes="primary small" VerticalAlignment="Center">
                    <TextBlock Text="Executar" />
                  </Button>
                </Grid>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding DiagnosticsChecks}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderThickness="0" MinHeight="260">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DiagnosticsCheckItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiInsetSm}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource WiiBrushTextMuted}" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsSettingsModuleSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <Border Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Tema" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <Grid Grid.Row="1" ColumnDefinitions="220,Auto,*" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Height="34">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:ThemeOptionViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Command="{Binding ApplySelectedThemeCommand}" Classes="primary small"><TextBlock Text="Aplicar" /></Button>
                    <TextBlock Grid.Column="2" Text="{Binding ThemeSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
              <Border Grid.Row="1" Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Layout" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <Grid Grid.Row="1" ColumnDefinitions="160,180,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <TextBox Text="{Binding DockLayoutName, Mode=TwoWay}" Height="34" Watermark="Layout" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DockLayouts}" SelectedItem="{Binding SelectedDockLayout}" Height="34" />
                    <Button Grid.Column="2" Command="{Binding SaveDockLayoutCommand}" Classes="secondary small"><TextBlock Text="Salvar" /></Button>
                    <Button Grid.Column="3" Command="{Binding LoadDockLayoutCommand}" Classes="secondary small"><TextBlock Text="Carregar" /></Button>
                    <Button Grid.Column="4" Command="{Binding ResetDockLayoutCommand}" Classes="tertiary small"><TextBlock Text="Reset" /></Button>
                    <TextBlock Grid.Column="5" Text="{Binding DockLayoutSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>

          <Border IsVisible="{Binding IsAssetsModuleSelected}" Classes="contentBlock">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <TextBlock Text="Capas e Assets" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
              <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Command="{Binding DownloadSelectedCoversCommand}" Classes="primary small"><TextBlock Text="Baixar capas" /></Button>
                <Button Grid.Column="1" Command="{Binding SynchronizeSelectedMetadataCommand}" Classes="secondary small"><TextBlock Text="Sincronizar metadados" /></Button>
                <TextBlock Grid.Column="2" Text="{Binding SelectionSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>

          <Border IsVisible="{Binding IsTasksModuleSelected}" Classes="contentBlock">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Text="Tarefas" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
              <TextBlock Grid.Row="1" Text="{Binding TaskSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
            </Grid>
          </Border>

          <Border IsVisible="{Binding IsNotificationsModuleSelected}" Classes="contentBlock">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Text="Notificações" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
              <TextBlock Grid.Row="1" Text="{Binding NotificationSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
            </Grid>
          </Border>

          <Border IsVisible="{Binding IsLogsModuleSelected}" Classes="contentBlock">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Text="Logs" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
              <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" Background="{DynamicResource WiiBrushBorder}" ResizeDirection="Columns" IsVisible="{Binding IsSidePanelVisible}" />

      <Border Grid.Column="4"
              Classes="sidePanel"
              IsVisible="{Binding IsSidePanelVisible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="18">
          <StackPanel Spacing="4">
            <TextBlock Text="Tarefas" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding TaskSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Notificações" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding NotificationSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="Dispositivo" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding DeviceManagerSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="Layout" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding DockLayoutSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock Text="Tema" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding ThemeSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="5" Background="{DynamicResource WiiBrushSurfaceAlt}" Padding="{StaticResource WiiInsetMd}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Diagnóstico"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WiiBrushTextPrimary}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding RunDiagnosticsCommand}"
                        Classes="secondary small">
                  <TextBlock Text="Executar" />
                </Button>
              </Grid>
              <TextBlock Grid.Row="1"
                         Text="{Binding DiagnosticsSummary}"
                         Foreground="{DynamicResource WiiBrushTextSecondary}"
                         TextWrapping="Wrap" />
              <ListBox Grid.Row="2"
                       ItemsSource="{Binding DiagnosticsChecks}"
                       MaxHeight="120"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DiagnosticsCheckItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiListItemCompactMargin}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource WiiBrushTextPrimary}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Status}"
                                   Foreground="{DynamicResource WiiBrushTextMuted}"
                                   FontSize="{StaticResource WiiFontSizeMicro}" />
                      </Grid>
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Message}"
                                 Foreground="{DynamicResource WiiBrushTextSecondary}"
                                 FontSize="{StaticResource WiiFontSizeMicro}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Row="6" Background="{DynamicResource WiiBrushSurfaceAlt}" Padding="{StaticResource WiiInsetMd}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Importação"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WiiBrushTextPrimary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ImportWizardState}"
                           Foreground="{DynamicResource WiiBrushTextMuted}"
                           FontSize="{StaticResource WiiFontSizeMicro}"
                           VerticalAlignment="Center" />
              </Grid>

              <ComboBox ItemsSource="{Binding ImportSteps}"
                        SelectedItem="{Binding SelectedImportStep}"
                        Height="32" />

              <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
                <TextBox Text="{Binding ImportSourcePathsText, Mode=TwoWay}"
                         Watermark="/jogos/mario.iso"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="70" />
                <Button Grid.Column="1"
                        Classes="secondary small"
                        Click="OnPickImportFilesClicked"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="Selecionar" TextTrimming="CharacterEllipsis" />
                </Button>
              </Grid>

              <ComboBox ItemsSource="{Binding Drives}"
                        SelectedItem="{Binding SelectedImportDrive}"
                        HorizontalContentAlignment="Stretch"
                        Height="32">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="domain:UsbDrive">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Command="{Binding AnalyzeImportCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Classes="secondary small"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="Analisar" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding ExecuteImportCommand}"
                        IsEnabled="{Binding CanExecuteImport}"
                        Classes="primary small"
                        HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Import}" />
                    <TextBlock Text="Importar" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </Grid>

              <Button Command="{Binding CancelImportCommand}"
                      Classes="tertiary small"
                      HorizontalAlignment="Stretch">
                <TextBlock Text="Cancelar" TextTrimming="CharacterEllipsis" />
              </Button>

              <TextBlock Classes="inlineFeedback"
                         Text="{Binding ImportSummary}"
                         Foreground="{DynamicResource WiiBrushTextSecondary}"
                         TextWrapping="Wrap" />

              <ListBox ItemsSource="{Binding ImportPreviewItems}"
                       MaxHeight="120"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ImportPreviewItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiListItemCompactMargin}">
                      <TextBlock Text="{Binding SourcePath}"
                                 Foreground="{DynamicResource WiiBrushTextPrimary}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Message}"
                                 Foreground="{DynamicResource WiiBrushTextMuted}"
                                 FontSize="{StaticResource WiiFontSizeMicro}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border Grid.Row="7" Background="{DynamicResource WiiBrushSurfaceAlt}" Padding="{StaticResource WiiInsetMd}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Conversão"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WiiBrushTextPrimary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ConversionWizardState}"
                           Foreground="{DynamicResource WiiBrushTextMuted}"
                           FontSize="{StaticResource WiiFontSizeMicro}"
                           VerticalAlignment="Center" />
              </Grid>

              <ComboBox ItemsSource="{Binding ConversionSteps}"
                        SelectedItem="{Binding SelectedConversionStep}"
                        Height="32" />

              <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
                <TextBox Text="{Binding ConversionSourcePathsText, Mode=TwoWay}"
                         Watermark="/jogos/mario.iso"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="58" />
                <Button Grid.Column="1"
                        Classes="secondary small"
                        Click="OnPickConversionFilesClicked"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="Selecionar" TextTrimming="CharacterEllipsis" />
                </Button>
              </Grid>

              <TextBox Text="{Binding ConversionDestinationDirectory, Mode=TwoWay}"
                       Watermark="/jogos/convertidos"
                       Height="32" />

              <ComboBox ItemsSource="{Binding ConversionTargetFormats}"
                        SelectedItem="{Binding SelectedConversionTargetFormat}"
                        Height="32" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Command="{Binding AnalyzeConversionCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Classes="secondary small"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="Analisar" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding ExecuteConversionCommand}"
                        IsEnabled="{Binding CanExecuteConversion}"
                        Classes="primary small"
                        HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Convert}" />
                    <TextBlock Text="Converter" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </Grid>

              <Button Command="{Binding CancelConversionCommand}"
                      Classes="tertiary small"
                      HorizontalAlignment="Stretch">
                <TextBlock Text="Cancelar" TextTrimming="CharacterEllipsis" />
              </Button>

              <TextBlock Classes="inlineFeedback"
                         Text="{Binding ConversionSummary}"
                         Foreground="{DynamicResource WiiBrushTextSecondary}"
                         TextWrapping="Wrap" />

              <ListBox ItemsSource="{Binding ConversionPreviewItems}"
                       MaxHeight="110"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ConversionPreviewItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiListItemCompactMargin}">
                      <TextBlock Text="{Binding SourcePath}"
                                 Foreground="{DynamicResource WiiBrushTextPrimary}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Pipeline}"
                                 Foreground="{DynamicResource WiiBrushTextMuted}"
                                 FontSize="{StaticResource WiiFontSizeMicro}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <ListBox Grid.Row="8"
                   ItemsSource="{Binding Devices}"
                   SelectedItem="{Binding SelectedDevice}"
                   Background="{DynamicResource WiiBrushSurfaceAlt}"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:DeviceInfoViewModel">
                <Grid RowDefinitions="Auto,Auto,Auto" Margin="{StaticResource WiiInsetSm}" MinHeight="58">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               Foreground="{DynamicResource WiiBrushTextMuted}"
                               FontSize="{StaticResource WiiFontSizeMicro}" />
                  </Grid>
                  <TextBlock Grid.Row="1"
                             Text="{Binding MountPoint}"
                             Foreground="{DynamicResource WiiBrushTextMuted}"
                             TextTrimming="CharacterEllipsis" />
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="{StaticResource WiiListButtonMargin}">
                    <TextBlock Text="{Binding FileSystem}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FreeSpace}"
                               Foreground="{DynamicResource WiiBrushTextSecondary}"
                               FontSize="{StaticResource WiiFontSizeMicro}" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource WiiBrushSurfaceRaised}"
              Padding="{StaticResource WiiPanelPadding}"
              Width="620"
              MaxHeight="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="{StaticResource WiiCommandPaletteMargin}"
              IsVisible="{Binding IsCommandPaletteOpen}">
        <Grid RowDefinitions="Auto,* ,Auto" RowSpacing="12">
          <TextBox Text="{Binding CommandPaletteQuery, Mode=TwoWay}"
                   Watermark="> Pesquise um comando..."
                   Height="40" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding CommandPaletteItems}"
                   SelectedItem="{Binding SelectedCommandPaletteItem}"
                   Background="{DynamicResource WiiBrushSurfaceAlt}"
                   BorderThickness="0"
                   MaxHeight="280">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:CommandPaletteItemViewModel">
                <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiCommandPaletteItemMargin}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource WiiBrushTextPrimary}"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Category}"
                               Foreground="{DynamicResource WiiBrushTextMuted}"
                               FontSize="{StaticResource WiiFontSizeMicro}" />
                  </Grid>
                  <TextBlock Grid.Row="1"
                             Text="{Binding Description}"
                             Foreground="{DynamicResource WiiBrushTextSecondary}"
                             FontSize="{StaticResource WiiFontSizeCaption}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding CommandPaletteState}"
                       Foreground="{DynamicResource WiiBrushTextMuted}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Command="{Binding ExecuteSelectedCommandPaletteItemCommand}"
                    Classes="primary small">
              <TextBlock Text="Executar" />
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding CloseCommandPaletteCommand}"
                    Classes="secondary small">
              <TextBlock Text="Fechar" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource WiiBrushChrome}" Padding="{StaticResource WiiInsetStatus}">
      <Grid ColumnDefinitions="1.6*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding StatusActiveDevice}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="2" Text="{Binding StatusFileSystem}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="3" Text="{Binding StatusFreeSpace}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="4" Text="{Binding SelectionSummary}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="5" Text="{Binding StatusTasks}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="6" Text="{Binding StatusNotifications}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="7" Text="{Binding StatusMemory}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="8" Text="{Binding StatusVersion}" Foreground="{DynamicResource WiiBrushTextMuted}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="0"
                Grid.RowSpan="3"
                Classes="toastHost"
                Margin="{StaticResource WiiFeedbackStackMargin}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsVisible="False" />

    <Border Grid.Row="0"
            Grid.RowSpan="3"
            Classes="modalScrim"
            IsVisible="False" />

    <Border Grid.Row="0"
            Grid.RowSpan="3"
            Classes="loadingState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="False">
      <StackPanel Classes="loadingContent">
        <ProgressBar Classes="spinner" />
        <TextBlock Text="Carregando..." />
      </StackPanel>
    </Border>
  </Grid>
</Window>
