<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:WiiStudio.Domain.Entities;assembly=WiiStudio.Domain"
        xmlns:dto="clr-namespace:WiiStudio.Application.DTOs;assembly=WiiStudio.Application"
        xmlns:vm="clr-namespace:WiiStudio.App.ViewModels"
        x:Class="WiiStudio.App.Views.MainWindow"
        Title="WiiStudio"
        Icon="/Assets/wiistudio.ico"
        Width="1280"
        Height="780"
        MinWidth="980"
        MinHeight="640">
  <Design.DataContext>
    <x:Null />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource WiiBrushBackground}">
    <Border Grid.Row="0" Classes="toolbar" Padding="{StaticResource WiiInsetToolbar}">
      <DockPanel LastChildFill="True">
      <Menu DockPanel.Dock="Top">
        <MenuItem Header="Arquivo">
          <MenuItem Header="Importar jogo..." Command="{Binding ExecuteShellCommandCommand}" CommandParameter="import.open" InputGesture="Ctrl+I" />
          <MenuItem Header="Exportar selecionados..." Command="{Binding ExportSelectedGamesCommand}" />
          <Separator />
          <MenuItem Header="Configurações" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.settings" InputGesture="Ctrl+," />
          <MenuItem Header="Sair" Command="{Binding ExitApplicationCommand}" InputGesture="Ctrl+Q" />
        </MenuItem>
        <MenuItem Header="Editar">
          <MenuItem Header="Copiar" Command="{Binding CopySelectionCommand}" InputGesture="Ctrl+C" />
          <MenuItem Header="Selecionar tudo" Command="{Binding SelectAllVisibleGamesCommand}" InputGesture="Ctrl+A" />
          <MenuItem Header="Limpar filtros" Command="{Binding ClearLibrarySearchCommand}" />
        </MenuItem>
        <MenuItem Header="Exibir">
          <MenuItem Header="Dashboard" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.dashboard" />
          <MenuItem Header="Biblioteca" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.library" />
          <MenuItem Header="Dispositivos" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.devices" />
          <Separator />
          <MenuItem Header="Mostrar/Ocultar painel lateral" Command="{Binding ToggleSidePanelCommand}" InputGesture="Ctrl+B" />
        </MenuItem>
        <MenuItem Header="Biblioteca">
          <MenuItem Header="Atualizar biblioteca" Command="{Binding RefreshLibraryCommand}" InputGesture="Ctrl+R" />
          <MenuItem Header="Sincronizar metadados" Command="{Binding SynchronizeSelectedMetadataCommand}" />
          <MenuItem Header="Baixar capas" Command="{Binding DownloadSelectedCoversCommand}" />
          <MenuItem Header="Remover selecionados" Command="{Binding RemoveSelectedGamesCommand}" Classes="danger" InputGesture="Delete" />
        </MenuItem>
        <MenuItem Header="Ferramentas">
          <MenuItem Header="Executar diagnóstico" Command="{Binding RunDiagnosticsCommand}" InputGesture="Ctrl+Shift+D" />
          <MenuItem Header="Abrir Command Palette" Command="{Binding OpenCommandPaletteCommand}" InputGesture="Ctrl+Shift+P" />
        </MenuItem>
        <MenuItem Header="Plugins">
          <MenuItem Header="Gerenciar plugins" Command="{Binding ManagePluginsCommand}" />
          <MenuItem Header="Recarregar plugins" Command="{Binding ReloadPluginsCommand}" />
        </MenuItem>
        <MenuItem Header="Ajuda">
          <MenuItem Header="Documentação" Command="{Binding ShowDocumentationCommand}" />
          <MenuItem Header="Atalhos de teclado" Command="{Binding ShowKeyboardShortcutsCommand}" />
          <MenuItem Header="Sobre o WiiStudio" Command="{Binding ShowAboutCommand}" />
        </MenuItem>
      </Menu>
      <WrapPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource WiiSpace8}"
                    VerticalAlignment="Center"
                    Margin="0,4,18,4">
          <Image Source="/Assets/wiistudio-icon.png"
                 Width="30"
                 Height="30"
                 Stretch="Uniform"
                 VerticalAlignment="Center" />
          <TextBlock Text="WiiStudio"
                     FontSize="{StaticResource WiiFontSizeTitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource WiiBrushTextPrimary}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,4,14,4">
          <Button Command="{Binding DetectDrivesCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Classes="primary">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Device}" />
              <TextBlock Text="Detectar HDs" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ToggleSidePanelCommand}" Classes="secondary">
            <TextBlock Text="Painel" />
          </Button>
          <TextBox Text="{Binding DockLayoutName, Mode=TwoWay}"
                   Classes="small"
                   Width="110"
                   Height="34"
                   Watermark="Layout" />
          <ComboBox ItemsSource="{Binding DockLayouts}"
                    SelectedItem="{Binding SelectedDockLayout}"
                    Width="132"
                    Height="34" />
          <Button Command="{Binding SaveDockLayoutCommand}" Classes="secondary small">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Save}" />
              <TextBlock Text="Salvar" />
            </StackPanel>
          </Button>
          <Button Command="{Binding LoadDockLayoutCommand}" Classes="secondary small">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Folder}" />
              <TextBlock Text="Carregar" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ResetDockLayoutCommand}" Classes="tertiary small" ToolTip.Tip="Restaurar layout padrão">
            <TextBlock Text="Reset" />
          </Button>
          <Button Command="{Binding OpenCommandPaletteCommand}" Classes="secondary small" ToolTip.Tip="Abrir command palette">
            <TextBlock Text="Comandos" />
          </Button>
          <ComboBox ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme}"
                    Width="120"
                    Height="34">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ThemeOptionViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Command="{Binding ApplySelectedThemeCommand}" Classes="secondary small" ToolTip.Tip="Aplicar tema selecionado">
            <TextBlock Text="Tema" />
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,4,0,4">
          <TextBox Classes="searchBox"
                   Width="300"
                   Watermark="Pesquisar jogos, tarefas e logs"
                   Text="{Binding LibrarySearchText, Mode=TwoWay}"
                   Height="36"
                   VerticalAlignment="Center" />

          <Border Classes="chip" VerticalAlignment="Center">
            <TextBlock Text="{Binding DockLayoutName}"
                       Foreground="{DynamicResource WiiBrushTextSecondary}"
                       VerticalAlignment="Center" />
          </Border>

          <Border Classes="chip" VerticalAlignment="Center">
            <TextBlock Text="{Binding State}"
                       Foreground="{DynamicResource WiiBrushTextMuted}"
                       VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </WrapPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="232,5,*,5,300">
      <Border Grid.Column="0" Background="{DynamicResource WiiBrushSidebar}" Padding="{StaticResource WiiInsetMd}">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top"
                     Text="Módulos"
                     Foreground="{DynamicResource WiiBrushTextMuted}"
                     FontWeight="SemiBold"
                     Margin="{StaticResource WiiSidebarHeadingMargin}" />
          <ListBox ItemsSource="{Binding Modules}"
                   Classes="navigation"
                   SelectedItem="{Binding SelectedModule}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="dto:ShellModule">
                <Border Classes="navigationItem" Margin="{StaticResource WiiModuleItemMargin}">
                  <Grid RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1"
                             Text="{Binding Description}"
                             Foreground="{DynamicResource WiiBrushTextMuted}"
                             FontSize="{StaticResource WiiFontSizeMicro}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="{DynamicResource WiiBrushBorder}" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="{StaticResource WiiWorkspaceMargin}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding SelectedModuleTitle}"
                     FontSize="{StaticResource WiiFontSizeHeading}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource WiiBrushTextPrimary}" />
          <TextBlock Text="{Binding SelectedModuleDescription}"
                     Foreground="{DynamicResource WiiBrushTextSecondary}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="{StaticResource WiiWorkspaceContentMargin}">
          <Grid IsVisible="{Binding IsDashboardModuleSelected}" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
              <ItemsControl ItemsSource="{Binding DashboardWidgets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:DashboardWidgetViewModel">
                    <Border Classes="metricTile" Margin="{StaticResource WiiDashboardCardMargin}">
                      <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextMuted}" FontWeight="SemiBold" FontSize="{StaticResource WiiFontSizeCaption}" />
                        <TextBlock Grid.Row="1" Classes="metricValue" Text="{Binding Value}" Foreground="{DynamicResource WiiBrushTextPrimary}" Margin="{StaticResource WiiMetricValueMargin}" />
                        <TextBlock Grid.Row="2" Text="{Binding Detail}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Classes="card" Padding="{StaticResource WiiInsetMd}">
                  <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Atividades" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding DashboardActivities}" MaxHeight="98" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DashboardActivityViewModel">
                          <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiListItemCompactMargin}">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="{Binding Detail}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" Padding="{StaticResource WiiInsetMd}">
                  <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Atalhos" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      <Button Grid.Column="1" Command="{Binding RefreshDashboardCommand}" Classes="icon small" ToolTip.Tip="Atualizar atalhos">
                        <PathIcon Classes="small" Data="{StaticResource WiiIcon.Refresh}" />
                      </Button>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding DashboardQuickActions}" MaxHeight="98" Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DashboardQuickActionViewModel">
                          <Button Command="{Binding DataContext.RunDashboardQuickActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Classes="tertiary small" Margin="{StaticResource WiiListButtonMargin}">
                            <TextBlock Text="{Binding Title}" />
                          </Button>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <Border Grid.Row="1" Classes="contentBlock" Margin="{StaticResource WiiSectionTopMargin}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="Resumo da Biblioteca" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <TextBlock Text="{Binding LibrarySummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LibraryState}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Command="{Binding RefreshLibraryCommand}" IsEnabled="{Binding !IsBusy}" Classes="secondary small" VerticalAlignment="Center">
                  <TextBlock Text="Atualizar biblioteca" />
                </Button>
                <Button Grid.Column="3" Command="{Binding ExecuteShellCommandCommand}" CommandParameter="navigation.library" Classes="primary small" VerticalAlignment="Center">
                  <TextBlock Text="Abrir" />
                </Button>
              </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="14" Margin="{StaticResource WiiSectionTopMargin}">
              <Border Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Saúde da Biblioteca" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                      <TextBlock Text="{Binding DashboardLibraryHealthSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top">
                      <TextBlock Text="{Binding DashboardUpdatedAt}" Foreground="{DynamicResource WiiBrushTextMuted}" />
                    </Border>
                  </Grid>

                  <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <PathIcon Classes="small" Data="{StaticResource WiiIcon.Library}" Foreground="{DynamicResource WiiBrushSuccess}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Capas" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      </Grid>
                      <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding DashboardCoverProgress}" Foreground="{DynamicResource WiiBrushSuccess}" />
                      <TextBlock Grid.Row="2" Text="{Binding DashboardCoverSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <PathIcon Classes="small" Data="{StaticResource WiiIcon.Success}" Foreground="{DynamicResource WiiBrushAccent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Metadados" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      </Grid>
                      <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding DashboardMetadataProgress}" Foreground="{DynamicResource WiiBrushAccent}" />
                      <TextBlock Grid.Row="2" Text="{Binding DashboardMetadataSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushWarning}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Favoritos" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      </Grid>
                      <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding DashboardFavoriteProgress}" Foreground="{DynamicResource WiiBrushWarning}" />
                      <TextBlock Grid.Row="2" Text="{Binding DashboardFavoriteSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Sistema" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Device}" Foreground="{DynamicResource WiiBrushAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding StatusActiveDevice}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StatusFileSystem}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Save}" Foreground="{DynamicResource WiiBrushSuccess}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding StatusFreeSpace}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="Espaço livre informado pelo sistema" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Settings}" Foreground="{DynamicResource WiiBrushWarning}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding StatusTasks}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StatusNotifications}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid IsVisible="{Binding IsLibraryModuleSelected}" RowDefinitions="Auto,Auto,*">
            <Border Classes="contentBlock">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="Biblioteca" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <TextBlock Text="{Binding LibrarySummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LibraryState}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding LibraryViewModes}"
                          SelectedItem="{Binding SelectedLibraryViewModeOption}"
                          Width="132"
                          Height="34"
                          VerticalAlignment="Center">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:LibraryViewModeOptionViewModel">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="3" Command="{Binding RefreshLibraryCommand}" IsEnabled="{Binding !IsBusy}" Classes="secondary" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Refresh}" />
                    <TextBlock Text="Atualizar" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="dataGridToolbar" Margin="{StaticResource WiiSectionTopMargin}">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBox Classes="searchBox" Watermark="Filtrar por título, ID ou região" Text="{Binding LibrarySearchText, Mode=TwoWay}" Height="34" />
                <WrapPanel Grid.Row="1">
                  <TextBlock Text="{Binding SelectionSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" Margin="{StaticResource WiiListButtonMargin}" />
                  <Button Command="{Binding SelectAllVisibleGamesCommand}" Classes="secondary small" VerticalAlignment="Center">
                    <TextBlock Text="Selecionar tudo" />
                  </Button>
                  <Button Command="{Binding ClearGameSelectionCommand}" Classes="tertiary small" VerticalAlignment="Center">
                    <TextBlock Text="Limpar seleção" />
                  </Button>
                  <Button Command="{Binding ToggleSelectedFavoritesCommand}" Classes="secondary small" VerticalAlignment="Center" ToolTip.Tip="Marcar ou remover favoritos dos jogos selecionados">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                      <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" />
                      <TextBlock Text="{Binding SelectedFavoriteActionText}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding DownloadSelectedCoversCommand}" IsEnabled="{Binding !IsBusy}" Classes="primary small" VerticalAlignment="Center">
                    <TextBlock Text="Baixar capas" />
                  </Button>
                  <Button Command="{Binding SynchronizeSelectedMetadataCommand}" IsEnabled="{Binding !IsBusy}" Classes="secondary small" VerticalAlignment="Center">
                    <TextBlock Text="Metadados" />
                  </Button>
                  <Button Command="{Binding CancelBatchOperationCommand}" IsVisible="{Binding IsCoverBatchRunning}" Classes="danger small" VerticalAlignment="Center">
                    <TextBlock Text="Cancelar" />
                  </Button>
                  <Button Command="{Binding ClearLibrarySearchCommand}" Classes="tertiary small" VerticalAlignment="Center">
                    <TextBlock Text="Limpar" />
                  </Button>
                </WrapPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,320" ColumnSpacing="12" Margin="{StaticResource WiiSectionTopMargin}">
              <Grid Classes="dataGrid" RowDefinitions="Auto,*">
                <Border Classes="dataGridHeader" IsVisible="{Binding IsLibraryDetailedViewSelected}">
                  <Grid ColumnDefinitions="38,56,88,2*,110,90,126" ColumnSpacing="10">
                    <TextBlock Classes="dataGridHeaderText" Text="" />
                    <TextBlock Classes="dataGridHeaderText" Grid.Column="1" Text="Capa" />
                    <TextBlock Classes="dataGridHeaderText" Grid.Column="2" Text="ID" />
                    <TextBlock Classes="dataGridHeaderText" Grid.Column="3" Text="Título" />
                    <TextBlock Classes="dataGridHeaderText" Grid.Column="4" Text="Formato" />
                    <TextBlock Classes="dataGridHeaderText" Grid.Column="5" Text="Tamanho" />
                    <TextBlock Classes="dataGridHeaderText" Grid.Column="6" Text="Status" />
                  </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectionMode="Multiple" SelectionChanged="OnLibrarySelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsLibraryGridViewSelected}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:LibraryGameItem">
                      <Border Width="156" MinHeight="230" Classes="metricTile" Margin="{StaticResource WiiDashboardCardMargin}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                          <Border Height="150" CornerRadius="{StaticResource WiiRadiusSmall}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                              <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                              <PathIcon Data="{StaticResource WiiIcon.Library}" Foreground="{DynamicResource WiiBrushTextMuted}" Width="36" Height="36" IsVisible="{Binding !HasCover}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"
                                      Classes="icon small"
                                      ToolTip.Tip="{Binding FavoriteActionText}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="{StaticResource WiiInsetXs}">
                                <Grid>
                                  <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushWarning}" IsVisible="{Binding IsFavorite}" />
                                  <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushTextMuted}" IsVisible="{Binding IsNotFavorite}" />
                                </Grid>
                              </Button>
                            </Grid>
                          </Border>
                          <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" />
                          <TextBlock Grid.Row="2" Text="{Binding Id}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                            <Border Classes="badge" ToolTip.Tip="{Binding Format}"><TextBlock Classes="badgeText" Text="{Binding Format}" /></Border>
                            <Border Classes="badge success" ToolTip.Tip="{Binding CoverStatusText}" IsVisible="{Binding HasCover}">
                              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Library}" Foreground="{DynamicResource WiiBrushSuccess}" />
                            </Border>
                            <Border Classes="badge success" ToolTip.Tip="{Binding MetadataStatusText}" IsVisible="{Binding HasMetadata}">
                              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Success}" Foreground="{DynamicResource WiiBrushSuccess}" />
                            </Border>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectionMode="Multiple" SelectionChanged="OnLibrarySelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsLibraryListViewSelected}">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:LibraryGameItem">
                      <Grid Classes="dataGridRow" ColumnDefinitions="38,88,2*,110,90,126" ColumnSpacing="10" Margin="{StaticResource WiiLibraryRowMargin}" MinHeight="58">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Command="{Binding DataContext.ToggleGameSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding MetadataSummary}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="3" Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Classes="badgeText" Text="{Binding Format}" /></Border>
                        <TextBlock Grid.Column="4" Text="{Binding Size}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <PathIcon Classes="small" Data="{StaticResource WiiIcon.Library}" Foreground="{DynamicResource WiiBrushSuccess}" ToolTip.Tip="{Binding CoverStatusText}" IsVisible="{Binding HasCover}" />
                          <PathIcon Classes="small" Data="{StaticResource WiiIcon.Warning}" Foreground="{DynamicResource WiiBrushWarning}" ToolTip.Tip="{Binding CoverStatusText}" IsVisible="{Binding !HasCover}" />
                          <PathIcon Classes="small" Data="{StaticResource WiiIcon.Success}" Foreground="{DynamicResource WiiBrushSuccess}" ToolTip.Tip="{Binding MetadataStatusText}" IsVisible="{Binding HasMetadata}" />
                          <PathIcon Classes="small" Data="{StaticResource WiiIcon.Settings}" Foreground="{DynamicResource WiiBrushWarning}" ToolTip.Tip="{Binding MetadataStatusText}" IsVisible="{Binding !HasMetadata}" />
                          <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Classes="icon small" ToolTip.Tip="{Binding FavoriteActionText}">
                            <Grid>
                              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushWarning}" IsVisible="{Binding IsFavorite}" />
                              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushTextMuted}" IsVisible="{Binding IsNotFavorite}" />
                            </Grid>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectionMode="Multiple" SelectionChanged="OnLibrarySelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsLibraryCompactViewSelected}">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:LibraryGameItem">
                      <Grid Classes="dataGridRow" ColumnDefinitions="38,88,*,90,Auto" ColumnSpacing="10" Margin="{StaticResource WiiLibraryRowMargin}" MinHeight="42">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Command="{Binding DataContext.ToggleGameSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Size}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <PathIcon Classes="small" Data="{StaticResource WiiIcon.Library}" Foreground="{DynamicResource WiiBrushSuccess}" ToolTip.Tip="{Binding CoverStatusText}" IsVisible="{Binding HasCover}" />
                          <PathIcon Classes="small" Data="{StaticResource WiiIcon.Success}" Foreground="{DynamicResource WiiBrushSuccess}" ToolTip.Tip="{Binding MetadataStatusText}" IsVisible="{Binding HasMetadata}" />
                          <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Classes="icon small" ToolTip.Tip="{Binding FavoriteActionText}">
                            <Grid>
                              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushWarning}" IsVisible="{Binding IsFavorite}" />
                              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushTextMuted}" IsVisible="{Binding IsNotFavorite}" />
                            </Grid>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectionMode="Multiple" SelectionChanged="OnLibrarySelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsLibraryDetailedViewSelected}">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:LibraryGameItem">
                      <Grid Classes="dataGridRow" ColumnDefinitions="38,56,88,2*,110,90,126" ColumnSpacing="10" Margin="{StaticResource WiiLibraryRowMargin}" MinHeight="72">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Command="{Binding DataContext.ToggleGameSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="44" Height="60" CornerRadius="{StaticResource WiiRadiusSmall}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                          <Grid>
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                            <TextBlock Text="--" IsVisible="{Binding !HasCover}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeCaption}" />
                          </Grid>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Id}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding MetadataSummary}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="4" Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Classes="badgeText" Text="{Binding Format}" /></Border>
                        <TextBlock Grid.Column="5" Text="{Binding Size}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Border Classes="badge success" Width="30" Height="28" ToolTip.Tip="{Binding CoverStatusText}" IsVisible="{Binding HasCover}">
                            <PathIcon Classes="small" Data="{StaticResource WiiIcon.Library}" Foreground="{DynamicResource WiiBrushSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Classes="badge warning" Width="30" Height="28" ToolTip.Tip="{Binding CoverStatusText}" IsVisible="{Binding !HasCover}">
                            <PathIcon Classes="small" Data="{StaticResource WiiIcon.Warning}" Foreground="{DynamicResource WiiBrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Classes="badge success" Width="30" Height="28" ToolTip.Tip="{Binding MetadataStatusText}" IsVisible="{Binding HasMetadata}">
                            <PathIcon Classes="small" Data="{StaticResource WiiIcon.Success}" Foreground="{DynamicResource WiiBrushSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Classes="badge warning" Width="30" Height="28" ToolTip.Tip="{Binding MetadataStatusText}" IsVisible="{Binding !HasMetadata}">
                            <PathIcon Classes="small" Data="{StaticResource WiiIcon.Settings}" Foreground="{DynamicResource WiiBrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Classes="icon small" ToolTip.Tip="{Binding FavoriteActionText}">
                            <Grid>
                              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" />
                              <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsNotFavorite}" />
                            </Grid>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <Border Grid.Column="1" Classes="contentBlock" MinWidth="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,150,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Detalhes" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <Border Grid.Row="1" CornerRadius="{StaticResource WiiRadiusMedium}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding SelectedCoverAsset.Image}" Stretch="Uniform" IsVisible="{Binding SelectedCoverAsset.HasImage}" />
                      <TextBlock Text="Imagem não disponível" IsVisible="{Binding !SelectedCoverAsset.HasImage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WiiBrushTextMuted}" />
                      <Button Command="{Binding OpenCoverLightboxCommand}" CommandParameter="{Binding SelectedCoverAsset}" IsVisible="{Binding SelectedCoverAsset.HasImage}" Classes="secondary small" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource WiiInsetSm}">
                        <TextBlock Text="Ampliar" />
                      </Button>
                    </Grid>
                  </Border>
                  <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding SelectedGame.Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedGame.Id}" Foreground="{DynamicResource WiiBrushTextMuted}" />
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedGame}" Classes="icon small" ToolTip.Tip="{Binding SelectedGame.FavoriteActionText}" VerticalAlignment="Top">
                        <Grid>
                          <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushWarning}" IsVisible="{Binding SelectedGame.IsFavorite}" />
                          <PathIcon Classes="small" Data="{StaticResource WiiIcon.Favorite}" Foreground="{DynamicResource WiiBrushTextMuted}" IsVisible="{Binding SelectedGame.IsNotFavorite}" />
                        </Grid>
                      </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding CoverBatchStatus}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  </Grid>
                  <Border Grid.Row="3"
                          Background="{DynamicResource WiiBrushSurfaceAlt}"
                          BorderBrush="{DynamicResource WiiBrushBorder}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource WiiRadiusMedium}"
                          Padding="{StaticResource WiiInsetSm}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Metadados" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                        <Border Grid.Column="1" Classes="badge success" IsVisible="{Binding SelectedGame.HasMetadata}">
                          <TextBlock Classes="badgeText" Text="OK" />
                        </Border>
                        <Border Grid.Column="1" Classes="badge warning" IsVisible="{Binding !SelectedGame.HasMetadata}">
                          <TextBlock Classes="badgeText" Text="Pendente" />
                        </Border>
                      </Grid>
                      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                        <TextBlock Text="Ano" Foreground="{DynamicResource WiiBrushTextMuted}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedGame.Year}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="Dev" Foreground="{DynamicResource WiiBrushTextMuted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGame.Developer}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="Pub" Foreground="{DynamicResource WiiBrushTextMuted}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGame.Publisher}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Text="Gênero" Foreground="{DynamicResource WiiBrushTextMuted}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedGame.Genres}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <UniformGrid Grid.Row="2" Columns="3">
                        <Border Classes="chip">
                          <StackPanel>
                            <TextBlock Text="Jogadores" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                            <TextBlock Text="{Binding SelectedGame.Players}" Foreground="{DynamicResource WiiBrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                        <Border Classes="chip" Margin="6,0,0,0">
                          <StackPanel>
                            <TextBlock Text="Rating" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                            <TextBlock Text="{Binding SelectedGame.Rating}" Foreground="{DynamicResource WiiBrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                        <Border Classes="chip" Margin="6,0,0,0">
                          <StackPanel>
                            <TextBlock Text="Região" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                            <TextBlock Text="{Binding SelectedGame.Region}" Foreground="{DynamicResource WiiBrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </UniformGrid>
                      <TextBlock Grid.Row="3" Text="{Binding SelectedGame.Description}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" MaxHeight="72" />
                    </Grid>
                  </Border>
                  <Border Grid.Row="4"
                          Background="{DynamicResource WiiBrushSurfaceAlt}"
                          BorderBrush="{DynamicResource WiiBrushBorder}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource WiiRadiusMedium}"
                          Padding="{StaticResource WiiInsetSm}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                      <TextBlock Text="Técnico e arquivo" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="1" Text="{Binding SelectedGameTechnicalSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2" Text="{Binding SelectedGameFileSummary}" Foreground="{DynamicResource WiiBrushTextMuted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                  <Border Grid.Row="5"
                          Background="{DynamicResource WiiBrushSurfaceAlt}"
                          BorderBrush="{DynamicResource WiiBrushBorder}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource WiiRadiusMedium}"
                          Padding="{StaticResource WiiInsetSm}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                      <TextBlock Text="Ações e histórico" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedGameActions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:GameDetailsActionItemViewModel">
                            <Border Classes="chip" Margin="0,0,6,6" ToolTip.Tip="{Binding StatusText}">
                              <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Grid.Row="2" Text="{Binding SelectedGameHistorySummary}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                      <ItemsControl Grid.Row="3" ItemsSource="{Binding SelectedGameHistory}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:GameDetailsHistoryItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                              <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" />
                              <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding CreatedAt}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                  <ListBox Grid.Row="6" ItemsSource="{Binding CoverAssets}" SelectedItem="{Binding SelectedCoverAsset}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="vm:CoverAssetViewModel">
                        <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10" Margin="{StaticResource WiiListItemCompactMargin}" MinHeight="64">
                          <Border Width="46" Height="58" CornerRadius="{StaticResource WiiRadiusSmall}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                              <Image Source="{Binding Image}" Stretch="UniformToFill" IsVisible="{Binding HasImage}" />
                              <TextBlock Text="--" IsVisible="{Binding !HasImage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WiiBrushTextMuted}" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                          </StackPanel>
                          <Button Grid.Column="2" Command="{Binding DataContext.OpenCoverLightboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding HasImage}" Classes="tertiary small" VerticalAlignment="Center">
                            <TextBlock Text="Ver" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>

          <ScrollViewer IsVisible="{Binding IsDevicesModuleSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
              <Border Classes="contentBlock">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <TextBlock Text="Dispositivos" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Text="{Binding DeviceManagerSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding !IsBusy}" Classes="primary small" VerticalAlignment="Center">
                    <TextBlock Text="Detectar" />
                  </Button>
                  <Button Grid.Column="2" Command="{Binding EjectSelectedDeviceCommand}" Classes="danger small" VerticalAlignment="Center">
                    <TextBlock Text="Ejetar" />
                  </Button>
                </Grid>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderThickness="0" MinHeight="260">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DeviceInfoViewModel">
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="{StaticResource WiiInsetMd}" MinHeight="72">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource WiiBrushTextMuted}" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding MountPoint}" Foreground="{DynamicResource WiiBrushTextMuted}" TextTrimming="CharacterEllipsis" />
                      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="14" Margin="{StaticResource WiiListButtonMargin}">
                        <TextBlock Text="{Binding FileSystem}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding FreeSpace}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                        <TextBlock Grid.Column="2" Text="{Binding Compatibility}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
                        <TextBlock Grid.Column="3" Text="{Binding DevicePath}" Foreground="{DynamicResource WiiBrushTextMuted}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Row="2" Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="Preparação Wii USB" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                      <TextBlock Text="{Binding UsbPreparationSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Command="{Binding PrepareFat32WbfsFolderCommand}" Classes="primary small"><TextBlock Text="Preparar FAT32" /></Button>
                      <Button Command="{Binding PreviewWbfsFormatCommand}" Classes="secondary small"><TextBlock Text="Preview WBFS" /></Button>
                    </WrapPanel>
                  </Grid>
                  <Border Grid.Row="1" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusMedium}" Padding="{StaticResource WiiInsetSm}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                      <TextBlock Text="WBFS é avançado e destrutivo. FAT32 com /wbfs é a opção recomendada para preservar dados." Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding UsbFormatConfirmationPhrase, Mode=TwoWay}" Watermark="Digite FORMATAR WBFS" Height="34" />
                        <Button Grid.Column="1" Command="{Binding ExecuteWbfsFormatCommand}" Classes="danger small"><TextBlock Text="Formatar WBFS" /></Button>
                      </Grid>
                    </Grid>
                  </Border>
                  <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Classes="chip">
                      <StackPanel>
                        <TextBlock Text="Alvo" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                        <TextBlock Text="{Binding UsbFormatPreview.TargetDisplayName}" Foreground="{DynamicResource WiiBrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="chip">
                      <StackPanel>
                        <TextBlock Text="Partição" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                        <TextBlock Text="{Binding UsbFormatPreview.PartitionPath}" Foreground="{DynamicResource WiiBrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="chip">
                      <StackPanel>
                        <TextBlock Text="Confirmação" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                        <TextBlock Text="{Binding UsbFormatPreview.RequiredConfirmationPhrase}" Foreground="{DynamicResource WiiBrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsConversionModuleSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
              <Border Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Conversão" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Grid.Column="1" Text="{Binding ConversionWizardState}" Foreground="{DynamicResource WiiBrushTextMuted}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="*,110" ColumnSpacing="8">
                    <TextBox Text="{Binding ConversionSourcePathsText, Mode=TwoWay}" Watermark="/jogos/mario.iso" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                    <Button Grid.Column="1" Classes="secondary small" Click="OnPickConversionFilesClicked" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                      <TextBlock Text="Selecionar" />
                    </Button>
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="*,160" ColumnSpacing="8">
                    <TextBox Text="{Binding ConversionDestinationDirectory, Mode=TwoWay}" Watermark="/jogos/convertidos" Height="34" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ConversionTargetFormats}" SelectedItem="{Binding SelectedConversionTargetFormat}" Height="34" />
                  </Grid>
                  <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Command="{Binding AnalyzeConversionCommand}" IsEnabled="{Binding !IsBusy}" Classes="secondary small"><TextBlock Text="Analisar" /></Button>
                    <Button Grid.Column="1" Command="{Binding ExecuteConversionCommand}" IsEnabled="{Binding CanExecuteConversion}" Classes="primary small"><TextBlock Text="Converter" /></Button>
                    <Button Grid.Column="2" Command="{Binding CancelConversionCommand}" Classes="tertiary small"><TextBlock Text="Cancelar" /></Button>
                    <TextBlock Grid.Column="3" Text="{Binding ConversionSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding ConversionPreviewItems}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderThickness="0" MinHeight="180">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ConversionPreviewItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiInsetSm}">
                      <TextBlock Text="{Binding SourcePath}" Foreground="{DynamicResource WiiBrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1" Text="{Binding Pipeline}" Foreground="{DynamicResource WiiBrushTextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsDiagnosticsModuleSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <Border Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                  <StackPanel>
                    <TextBlock Text="Diagnóstico" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Text="{Binding DiagnosticsSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DiagnosticsExportPath}" Foreground="{DynamicResource WiiBrushTextMuted}" TextWrapping="Wrap" FontSize="{StaticResource WiiFontSizeMicro}" />
                  </StackPanel>
                  <WrapPanel Grid.Row="1" HorizontalAlignment="Left">
                    <Button Command="{Binding RunDiagnosticsCommand}" Classes="primary small" MinWidth="110">
                      <TextBlock Text="Executar" />
                    </Button>
                    <Button Command="{Binding RunWiiUsbReadinessCheckCommand}" Classes="secondary small" MinWidth="150">
                      <TextBlock Text="Verificar Wii USB" />
                    </Button>
                    <Button Command="{Binding ExportDiagnosticsCommand}" Classes="secondary small" MinWidth="140">
                      <TextBlock Text="Exportar" />
                    </Button>
                  </WrapPanel>
                </Grid>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding DiagnosticsChecks}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderThickness="0" MinHeight="260">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DiagnosticsCheckItemViewModel">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="{StaticResource WiiInsetSm}" RowSpacing="4">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource WiiBrushTextMuted}" />
                        <Button Grid.Column="2"
                                Command="{Binding DataContext.RepairDiagnosticCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding HasRepairAction}"
                                Classes="secondary small"
                                ToolTip.Tip="{Binding RepairRiskText}">
                          <TextBlock Text="{Binding RepairActionTitle}" />
                        </Button>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="2"
                                 Text="{Binding RepairActionDescription}"
                                 Foreground="{DynamicResource WiiBrushTextMuted}"
                                 FontSize="{StaticResource WiiFontSizeMicro}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasRepairActionDescription}" />
                      <TextBlock Grid.Row="3"
                                 Text="{Binding LastRepairStatusText}"
                                 Foreground="{DynamicResource WiiBrushAccent}"
                                 FontSize="{StaticResource WiiFontSizeMicro}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasLastRepair}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </ScrollViewer>

          <Grid IsVisible="{Binding IsPluginsModuleSelected}" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Classes="contentBlock">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Text="Plugins" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Text="{Binding PluginSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshPluginsCommand}" Classes="secondary small"><TextBlock Text="Atualizar" /></Button>
                    <Button Command="{Binding ReloadPluginsCommand}" Classes="primary small"><TextBlock Text="Recarregar" /></Button>
                  </WrapPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding PluginInstallPath, Mode=TwoWay}" Height="34" Watermark="Pasta ou .zip do plugin local" />
                  <Button Grid.Column="1" Command="{Binding InstallPluginCommand}" Classes="primary small"><TextBlock Text="Instalar" /></Button>
                </Grid>
              </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="12">
              <Border Classes="contentBlock">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                  <TextBlock Text="Instalados" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <ListBox Grid.Row="1" ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedPlugin}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="vm:PluginManagementItemViewModel">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="{StaticResource WiiListItemCompactMargin}" MinHeight="58">
                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="1" Classes="badge success" IsVisible="{Binding IsReady}"><TextBlock Classes="badgeText" Text="Pronto" /></Border>
                          <Border Grid.Column="1" Classes="badge warning" IsVisible="{Binding IsDisabled}"><TextBlock Classes="badgeText" Text="Off" /></Border>
                          <Border Grid.Column="1" Classes="badge danger" IsVisible="{Binding HasIssues}"><TextBlock Classes="badgeText" Text="Atenção" /></Border>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Summary}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                      <TextBlock Text="{Binding SelectedPlugin.Description}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                      <Button Command="{Binding EnablePluginCommand}" CommandParameter="{Binding SelectedPlugin}" IsEnabled="{Binding SelectedPlugin.CanEnable}" Classes="secondary small"><TextBlock Text="Habilitar" /></Button>
                      <Button Command="{Binding DisablePluginCommand}" CommandParameter="{Binding SelectedPlugin}" IsEnabled="{Binding SelectedPlugin.CanDisable}" Classes="tertiary small"><TextBlock Text="Desabilitar" /></Button>
                      <Button Command="{Binding RemovePluginCommand}" CommandParameter="{Binding SelectedPlugin}" IsEnabled="{Binding SelectedPlugin.CanRemove}" Classes="danger small"><TextBlock Text="Remover" /></Button>
                    </WrapPanel>
                  </Grid>

                  <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusMedium}" Padding="{StaticResource WiiInsetSm}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Capacidades" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedPlugin.Capabilities}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusMedium}" Padding="{StaticResource WiiInsetSm}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Local" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedPlugin.DirectoryPath}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusMedium}" Padding="{StaticResource WiiInsetSm}">
                      <Grid RowDefinitions="Auto,*" RowSpacing="6">
                        <TextBlock Text="Permissões" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedPlugin.Permissions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,3" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusMedium}" Padding="{StaticResource WiiInsetSm}">
                      <Grid RowDefinitions="Auto,*" RowSpacing="6">
                        <TextBlock Text="Problemas" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedPlugin.Errors}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WiiBrushDanger}" TextWrapping="Wrap" Margin="0,0,0,3" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </Grid>

                  <Border Grid.Row="3" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusMedium}" Padding="{StaticResource WiiInsetSm}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="6">
                      <TextBlock Text="Diagnóstico" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                      <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPlugin.Diagnostics}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,3" /></DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <ScrollViewer IsVisible="{Binding IsSettingsModuleSelected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <Border Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Tema" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <Grid Grid.Row="1" ColumnDefinitions="220,Auto,*" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Height="34">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:ThemeOptionViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Command="{Binding ApplySelectedThemeCommand}" Classes="primary small"><TextBlock Text="Aplicar" /></Button>
                    <TextBlock Grid.Column="2" Text="{Binding ThemeSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
              <Border Grid.Row="1" Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Layout" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <Grid Grid.Row="1" ColumnDefinitions="160,180,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <TextBox Text="{Binding DockLayoutName, Mode=TwoWay}" Height="34" Watermark="Layout" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DockLayouts}" SelectedItem="{Binding SelectedDockLayout}" Height="34" />
                    <Button Grid.Column="2" Command="{Binding SaveDockLayoutCommand}" Classes="secondary small"><TextBlock Text="Salvar" /></Button>
                    <Button Grid.Column="3" Command="{Binding LoadDockLayoutCommand}" Classes="secondary small"><TextBlock Text="Carregar" /></Button>
                    <Button Grid.Column="4" Command="{Binding ResetDockLayoutCommand}" Classes="tertiary small"><TextBlock Text="Reset" /></Button>
                    <TextBlock Grid.Column="5" Text="{Binding DockLayoutSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>

          <Grid IsVisible="{Binding IsAssetsModuleSelected}" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Classes="contentBlock">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Text="Capas e Assets" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Text="{Binding AssetSelectionSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding DownloadSelectedCoversCommand}" Classes="primary small" VerticalAlignment="Center"><TextBlock Text="Baixar capas" /></Button>
                    <Button Command="{Binding SynchronizeSelectedMetadataCommand}" Classes="secondary small" VerticalAlignment="Center"><TextBlock Text="Sincronizar metadados" /></Button>
                    <Button Command="{Binding ForceRefreshSelectedAssetsCommand}" Classes="secondary small" VerticalAlignment="Center"><TextBlock Text="Forçar assets" /></Button>
                    <Button Command="{Binding ValidateSelectedAssetsCommand}" Classes="secondary small" VerticalAlignment="Center"><TextBlock Text="Validar" /></Button>
                    <Button Command="{Binding ClearSelectedAssetCacheCommand}" Classes="tertiary small" VerticalAlignment="Center"><TextBlock Text="Limpar cache" /></Button>
                    <Button Command="{Binding CancelBatchOperationCommand}" IsVisible="{Binding IsCoverBatchRunning}" Classes="danger small" VerticalAlignment="Center"><TextBlock Text="Cancelar" /></Button>
                  </WrapPanel>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusMedium}" Padding="{StaticResource WiiInsetSm}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Settings}" Foreground="{DynamicResource WiiBrushAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="8">
                      <Grid ColumnDefinitions="Auto,96,*" ColumnSpacing="10">
                        <TextBlock Text="Idioma" Foreground="{DynamicResource WiiBrushTextMuted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedAssetLanguage}" Watermark="PT" />
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding BulkAssetKindOptions}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CoverAssetKindOptionViewModel">
                              <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" Margin="0,0,10,0" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusMedium}" Padding="{StaticResource WiiInsetSm}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Refresh}" Foreground="{DynamicResource WiiBrushAccent}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CoverBatchStatus}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="300,*,340" ColumnSpacing="12">
              <Border Classes="contentBlock">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                  <TextBlock Text="Jogos selecionados" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <ListBox Grid.Row="1" ItemsSource="{Binding AssetSelectedGames}" SelectedItem="{Binding SelectedAssetGame}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="vm:LibraryGameItem">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10" Margin="{StaticResource WiiListItemCompactMargin}" MinHeight="58">
                          <Border Width="38" Height="52" CornerRadius="{StaticResource WiiRadiusSmall}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                              <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                              <TextBlock Text="--" IsVisible="{Binding !HasCover}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Id}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Classes="small" Data="{StaticResource WiiIcon.Library}" Foreground="{DynamicResource WiiBrushSuccess}" ToolTip.Tip="{Binding CoverStatusText}" IsVisible="{Binding HasCover}" />
                            <PathIcon Classes="small" Data="{StaticResource WiiIcon.Warning}" Foreground="{DynamicResource WiiBrushWarning}" ToolTip.Tip="{Binding CoverStatusText}" IsVisible="{Binding !HasCover}" />
                            <PathIcon Classes="small" Data="{StaticResource WiiIcon.Success}" Foreground="{DynamicResource WiiBrushSuccess}" ToolTip.Tip="{Binding MetadataStatusText}" IsVisible="{Binding HasMetadata}" />
                            <PathIcon Classes="small" Data="{StaticResource WiiIcon.Settings}" Foreground="{DynamicResource WiiBrushWarning}" ToolTip.Tip="{Binding MetadataStatusText}" IsVisible="{Binding !HasMetadata}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="contentBlock">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                  <StackPanel>
                    <TextBlock Text="Assets baixados" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Text="{Binding AssetGallerySummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ListBox Grid.Row="1" ItemsSource="{Binding CoverAssets}" SelectedItem="{Binding SelectedCoverAsset}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="vm:CoverAssetViewModel">
                        <Border Width="132" MinHeight="190" Classes="metricTile" Margin="{StaticResource WiiDashboardCardMargin}">
                          <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Border Height="118" CornerRadius="{StaticResource WiiRadiusSmall}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" ClipToBounds="True">
                              <Grid>
                                <Image Source="{Binding Image}" Stretch="UniformToFill" IsVisible="{Binding HasImage}" />
                                <TextBlock Text="--" IsVisible="{Binding !HasImage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WiiBrushTextMuted}" />
                              </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{Binding StateText}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="3" Command="{Binding DataContext.OpenCoverLightboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding HasImage}" Classes="tertiary small" HorizontalAlignment="Left">
                              <TextBlock Text="Ver" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="2" Classes="contentBlock">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                  <TextBlock Text="Metadados baixados" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <TextBlock Grid.Row="1" Text="{Binding AssetMetadataSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                  <ListBox Grid.Row="2" ItemsSource="{Binding AssetSelectedGames}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="vm:LibraryGameItem">
                        <Border Background="{DynamicResource WiiBrushSurfaceAlt}" BorderBrush="{DynamicResource WiiBrushBorder}" BorderThickness="1" CornerRadius="{StaticResource WiiRadiusSmall}" Padding="{StaticResource WiiInsetSm}" Margin="{StaticResource WiiListItemCompactMargin}">
                          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <Border Grid.Column="1" Classes="badge success" IsVisible="{Binding HasMetadata}"><TextBlock Classes="badgeText" Text="OK" /></Border>
                              <Border Grid.Column="1" Classes="badge warning" IsVisible="{Binding !HasMetadata}"><TextBlock Classes="badgeText" Text="Pendente" /></Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding MetadataSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{Binding Genres}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid IsVisible="{Binding IsTasksModuleSelected}" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Classes="contentBlock">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Text="Tarefas" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <TextBlock Text="{Binding TaskSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshTasksCommand}" Classes="secondary small" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Refresh}" />
                    <TextBlock Text="Atualizar" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:TaskItemViewModel">
                  <Grid Classes="dataGridRow" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="6" Margin="{StaticResource WiiLibraryRowMargin}" MinHeight="96">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Classes="badge" HorizontalAlignment="Right">
                      <TextBlock Classes="badgeText" Text="{Binding Status}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Priority}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                      <TextBlock Grid.Column="1" Text="{Binding UpdatedAt}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                    </Grid>
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource WiiBrushDanger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Grid IsVisible="{Binding IsNotificationsModuleSelected}" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Classes="contentBlock">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Text="Notificações" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                  <TextBlock Text="{Binding NotificationSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshNotificationsCommand}" Classes="secondary small" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Refresh}" />
                    <TextBlock Text="Atualizar" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:NotificationItemViewModel">
                  <Grid Classes="dataGridRow" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="6" Margin="{StaticResource WiiLibraryRowMargin}" MinHeight="86">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Classes="badge" HorizontalAlignment="Right">
                      <TextBlock Classes="badgeText" Text="{Binding Type}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding HasProgress}" />
                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{Binding CreatedAt}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                      <Button Grid.Column="1"
                              Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Classes="secondary small"
                              IsVisible="{Binding !IsDismissed}">
                        <TextBlock Text="Dispensar" />
                      </Button>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Grid IsVisible="{Binding IsLogsModuleSelected}" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Classes="contentBlock">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <TextBlock Text="Logs" FontSize="{StaticResource WiiFontSizeSubtitle}" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
                    <TextBlock Text="{Binding LogsSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LogsExportPath}" Foreground="{DynamicResource WiiBrushTextMuted}" TextWrapping="Wrap" FontSize="{StaticResource WiiFontSizeMicro}" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshLogsCommand}" Classes="secondary small" MinWidth="100">
                      <TextBlock Text="Atualizar" />
                    </Button>
                    <Button Command="{Binding ExportLogsCommand}" Classes="primary small" MinWidth="120">
                      <TextBlock Text="Exportar TXT" />
                    </Button>
                  </WrapPanel>
                </Grid>
              </Grid>
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="{DynamicResource WiiBrushSurfaceAlt}" BorderThickness="0" MinHeight="260">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LogEntryViewModel">
                  <Grid RowDefinitions="Auto,Auto,Auto" Margin="{StaticResource WiiInsetSm}" RowSpacing="4">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                      <Border Grid.Column="1" Classes="badge"><TextBlock Classes="badgeText" Text="{Binding Level}" /></Border>
                      <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding Source}" Foreground="{DynamicResource WiiBrushTextMuted}" FontSize="{StaticResource WiiFontSizeMicro}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="{Binding Exception}" Foreground="{DynamicResource WiiBrushDanger}" TextWrapping="Wrap" IsVisible="{Binding HasException}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" Background="{DynamicResource WiiBrushBorder}" ResizeDirection="Columns" IsVisible="{Binding IsSidePanelVisible}" />

      <Border Grid.Column="4"
              Classes="sidePanel"
              IsVisible="{Binding IsSidePanelVisible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="18">
          <StackPanel Spacing="4">
            <TextBlock Text="Tarefas" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding TaskSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Notificações" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding NotificationSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="Dispositivo" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding DeviceManagerSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="Layout" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding DockLayoutSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock Text="Tema" FontWeight="SemiBold" Foreground="{DynamicResource WiiBrushTextPrimary}" />
            <TextBlock Text="{Binding ThemeSummary}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="5" Background="{DynamicResource WiiBrushSurfaceAlt}" Padding="{StaticResource WiiInsetMd}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Assistente inicial"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WiiBrushTextPrimary}"
                           VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="badge">
                    <TextBlock Classes="badgeText" Text="{Binding FirstRunCurrentStep}" />
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="{Binding FirstRunWizardSummary}"
                           Foreground="{DynamicResource WiiBrushTextSecondary}"
                           TextWrapping="Wrap" />
                <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                  <TextBox Text="{Binding FirstRunLanguage}" Watermark="Idioma" />
                  <TextBox Grid.Column="1" Text="{Binding FirstRunTheme}" Watermark="Tema" />
                  <TextBox Grid.Row="1" Text="{Binding FirstRunLibraryPath}" Watermark="Pasta da biblioteca" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FirstRunExportPath}" Watermark="Pasta de exportação" />
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding CompleteFirstRunSetupCommand}" Classes="primary small" MinHeight="32">
                    <TextBlock Text="Executar assistente" />
                  </Button>
                  <Button Command="{Binding SkipFirstRunSetupCommand}" Classes="tertiary small" MinHeight="32">
                    <TextBlock Text="Pular" />
                  </Button>
                </StackPanel>
              </Grid>
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding FirstRunSetupSummary}"
                       MaxHeight="110"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Text="Diagnóstico"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WiiBrushTextPrimary}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Spacing="6">
                  <Button Command="{Binding RunDiagnosticsCommand}" Classes="secondary small" HorizontalAlignment="Stretch" MinHeight="32">
                    <TextBlock Text="Executar diagnóstico" />
                  </Button>
                  <Button Command="{Binding ExportDiagnosticsCommand}" Classes="secondary small" HorizontalAlignment="Stretch" MinHeight="32">
                    <TextBlock Text="Exportar" />
                  </Button>
                </StackPanel>
              </Grid>
              <TextBlock Grid.Row="3"
                         Text="{Binding DiagnosticsSummary}"
                         Foreground="{DynamicResource WiiBrushTextSecondary}"
                         TextWrapping="Wrap" />
              <ListBox Grid.Row="4"
                       ItemsSource="{Binding DiagnosticsChecks}"
                       MaxHeight="120"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DiagnosticsCheckItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiListItemCompactMargin}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource WiiBrushTextPrimary}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Status}"
                                   Foreground="{DynamicResource WiiBrushTextMuted}"
                                   FontSize="{StaticResource WiiFontSizeMicro}" />
                      </Grid>
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Message}"
                                 Foreground="{DynamicResource WiiBrushTextSecondary}"
                                 FontSize="{StaticResource WiiFontSizeMicro}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Row="6" Background="{DynamicResource WiiBrushSurfaceAlt}" Padding="{StaticResource WiiInsetMd}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Importação"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WiiBrushTextPrimary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ImportWizardState}"
                           Foreground="{DynamicResource WiiBrushTextMuted}"
                           FontSize="{StaticResource WiiFontSizeMicro}"
                           VerticalAlignment="Center" />
              </Grid>

              <ComboBox ItemsSource="{Binding ImportSteps}"
                        SelectedItem="{Binding SelectedImportStep}"
                        Height="32" />

              <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
                <TextBox Text="{Binding ImportSourcePathsText, Mode=TwoWay}"
                         Watermark="/jogos/mario.iso"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="70" />
                <Button Grid.Column="1"
                        Classes="secondary small"
                        Click="OnPickImportFilesClicked"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="Selecionar" TextTrimming="CharacterEllipsis" />
                </Button>
              </Grid>

              <ComboBox ItemsSource="{Binding Drives}"
                        SelectedItem="{Binding SelectedImportDrive}"
                        HorizontalContentAlignment="Stretch"
                        Height="32">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="domain:UsbDrive">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Command="{Binding AnalyzeImportCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Classes="secondary small"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="Analisar" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding ExecuteImportCommand}"
                        IsEnabled="{Binding CanExecuteImport}"
                        Classes="primary small"
                        HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Import}" />
                    <TextBlock Text="Importar" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </Grid>

              <Button Command="{Binding CancelImportCommand}"
                      Classes="tertiary small"
                      HorizontalAlignment="Stretch">
                <TextBlock Text="Cancelar" TextTrimming="CharacterEllipsis" />
              </Button>

              <TextBlock Classes="inlineFeedback"
                         Text="{Binding ImportSummary}"
                         Foreground="{DynamicResource WiiBrushTextSecondary}"
                         TextWrapping="Wrap" />

              <ListBox ItemsSource="{Binding ImportPreviewItems}"
                       MaxHeight="120"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ImportPreviewItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiListItemCompactMargin}">
                      <TextBlock Text="{Binding SourcePath}"
                                 Foreground="{DynamicResource WiiBrushTextPrimary}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Message}"
                                 Foreground="{DynamicResource WiiBrushTextMuted}"
                                 FontSize="{StaticResource WiiFontSizeMicro}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border Grid.Row="7" Background="{DynamicResource WiiBrushSurfaceAlt}" Padding="{StaticResource WiiInsetMd}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Conversão"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WiiBrushTextPrimary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ConversionWizardState}"
                           Foreground="{DynamicResource WiiBrushTextMuted}"
                           FontSize="{StaticResource WiiFontSizeMicro}"
                           VerticalAlignment="Center" />
              </Grid>

              <ComboBox ItemsSource="{Binding ConversionSteps}"
                        SelectedItem="{Binding SelectedConversionStep}"
                        Height="32" />

              <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
                <TextBox Text="{Binding ConversionSourcePathsText, Mode=TwoWay}"
                         Watermark="/jogos/mario.iso"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="58" />
                <Button Grid.Column="1"
                        Classes="secondary small"
                        Click="OnPickConversionFilesClicked"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="Selecionar" TextTrimming="CharacterEllipsis" />
                </Button>
              </Grid>

              <TextBox Text="{Binding ConversionDestinationDirectory, Mode=TwoWay}"
                       Watermark="/jogos/convertidos"
                       Height="32" />

              <ComboBox ItemsSource="{Binding ConversionTargetFormats}"
                        SelectedItem="{Binding SelectedConversionTargetFormat}"
                        Height="32" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Command="{Binding AnalyzeConversionCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Classes="secondary small"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="Analisar" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding ExecuteConversionCommand}"
                        IsEnabled="{Binding CanExecuteConversion}"
                        Classes="primary small"
                        HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource WiiSpace8}">
                    <PathIcon Classes="small" Data="{StaticResource WiiIcon.Convert}" />
                    <TextBlock Text="Converter" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </Grid>

              <Button Command="{Binding CancelConversionCommand}"
                      Classes="tertiary small"
                      HorizontalAlignment="Stretch">
                <TextBlock Text="Cancelar" TextTrimming="CharacterEllipsis" />
              </Button>

              <TextBlock Classes="inlineFeedback"
                         Text="{Binding ConversionSummary}"
                         Foreground="{DynamicResource WiiBrushTextSecondary}"
                         TextWrapping="Wrap" />

              <ListBox ItemsSource="{Binding ConversionPreviewItems}"
                       MaxHeight="110"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ConversionPreviewItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiListItemCompactMargin}">
                      <TextBlock Text="{Binding SourcePath}"
                                 Foreground="{DynamicResource WiiBrushTextPrimary}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Pipeline}"
                                 Foreground="{DynamicResource WiiBrushTextMuted}"
                                 FontSize="{StaticResource WiiFontSizeMicro}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <ListBox Grid.Row="8"
                   ItemsSource="{Binding Devices}"
                   SelectedItem="{Binding SelectedDevice}"
                   Background="{DynamicResource WiiBrushSurfaceAlt}"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:DeviceInfoViewModel">
                <Grid RowDefinitions="Auto,Auto,Auto" Margin="{StaticResource WiiInsetSm}" MinHeight="58">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               Foreground="{DynamicResource WiiBrushTextMuted}"
                               FontSize="{StaticResource WiiFontSizeMicro}" />
                  </Grid>
                  <TextBlock Grid.Row="1"
                             Text="{Binding MountPoint}"
                             Foreground="{DynamicResource WiiBrushTextMuted}"
                             TextTrimming="CharacterEllipsis" />
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="{StaticResource WiiListButtonMargin}">
                    <TextBlock Text="{Binding FileSystem}" Foreground="{DynamicResource WiiBrushTextSecondary}" FontSize="{StaticResource WiiFontSizeMicro}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FreeSpace}"
                               Foreground="{DynamicResource WiiBrushTextSecondary}"
                               FontSize="{StaticResource WiiFontSizeMicro}" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource WiiBrushSurfaceRaised}"
              Padding="{StaticResource WiiPanelPadding}"
              Width="620"
              MaxHeight="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="{StaticResource WiiCommandPaletteMargin}"
              IsVisible="{Binding IsCommandPaletteOpen}">
        <Grid RowDefinitions="Auto,* ,Auto" RowSpacing="12">
          <TextBox Text="{Binding CommandPaletteQuery, Mode=TwoWay}"
                   Watermark="> Pesquise um comando..."
                   Height="40" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding CommandPaletteItems}"
                   SelectedItem="{Binding SelectedCommandPaletteItem}"
                   Background="{DynamicResource WiiBrushSurfaceAlt}"
                   BorderThickness="0"
                   MaxHeight="280">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:CommandPaletteItemViewModel">
                <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource WiiCommandPaletteItemMargin}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource WiiBrushTextPrimary}"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Category}"
                               Foreground="{DynamicResource WiiBrushTextMuted}"
                               FontSize="{StaticResource WiiFontSizeMicro}" />
                  </Grid>
                  <TextBlock Grid.Row="1"
                             Text="{Binding Description}"
                             Foreground="{DynamicResource WiiBrushTextSecondary}"
                             FontSize="{StaticResource WiiFontSizeCaption}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding CommandPaletteState}"
                       Foreground="{DynamicResource WiiBrushTextMuted}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Command="{Binding ExecuteSelectedCommandPaletteItemCommand}"
                    Classes="primary small">
              <TextBlock Text="Executar" />
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding CloseCommandPaletteCommand}"
                    Classes="secondary small">
              <TextBlock Text="Fechar" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource WiiBrushChrome}" Padding="{StaticResource WiiInsetStatus}">
      <Grid ColumnDefinitions="1.6*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource WiiBrushTextSecondary}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding StatusActiveDevice}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="2" Text="{Binding StatusFileSystem}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="3" Text="{Binding StatusFreeSpace}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="4" Text="{Binding SelectionSummary}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="5" Text="{Binding StatusTasks}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="6" Text="{Binding StatusNotifications}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="7" Text="{Binding StatusMemory}" Foreground="{DynamicResource WiiBrushTextMuted}" />
        <TextBlock Grid.Column="8" Text="{Binding StatusVersion}" Foreground="{DynamicResource WiiBrushTextMuted}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="0"
                Grid.RowSpan="3"
                Classes="toastHost"
                Margin="{StaticResource WiiFeedbackStackMargin}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsVisible="False" />

    <Border Grid.Row="0"
            Grid.RowSpan="3"
            Classes="modalScrim"
            IsVisible="{Binding IsCoverLightboxOpen}">
      <Button Command="{Binding CloseCoverLightboxCommand}" Background="Transparent" BorderThickness="0" />
    </Border>

    <Border Grid.Row="0"
            Grid.RowSpan="3"
            Classes="modalPanel large"
            MaxWidth="860"
            MaxHeight="720"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding IsCoverLightboxOpen}">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding SelectedCoverAsset.Title}" Foreground="{DynamicResource WiiBrushTextPrimary}" FontWeight="SemiBold" />
          <Button Grid.Column="1" Command="{Binding CloseCoverLightboxCommand}" Classes="secondary small">
            <TextBlock Text="Fechar" />
          </Button>
        </Grid>
        <Image Grid.Row="1" Source="{Binding SelectedCoverAsset.Image}" Stretch="Uniform" />
      </Grid>
    </Border>

    <Border Grid.Row="0"
            Grid.RowSpan="3"
            Classes="loadingState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="False">
      <StackPanel Classes="loadingContent">
        <ProgressBar Classes="spinner" />
        <TextBlock Text="Carregando..." />
      </StackPanel>
    </Border>
  </Grid>
</Window>
