<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:WiiStudio.Domain.Entities;assembly=WiiStudio.Domain"
        xmlns:dto="clr-namespace:WiiStudio.Application.DTOs;assembly=WiiStudio.Application"
        xmlns:vm="clr-namespace:WiiStudio.App.ViewModels"
        x:Class="WiiStudio.App.Views.MainWindow"
        Title="WiiStudio"
        Width="1280"
        Height="780"
        MinWidth="980"
        MinHeight="640">
  <Design.DataContext>
    <x:Null />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto" Background="#101319">
    <Border Grid.Row="0" Background="#1A1F28" Padding="18,14">
      <Grid ColumnDefinitions="Auto,*,320,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
        <TextBlock Text="WiiStudio"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#F6F8FC"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding DetectDrivesCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Padding="14,8">
            <TextBlock Text="Detectar HDs" />
          </Button>
          <Button Command="{Binding ToggleSidePanelCommand}" Padding="14,8">
            <TextBlock Text="Painel" />
          </Button>
          <TextBox Text="{Binding DockLayoutName, Mode=TwoWay}"
                   Width="110"
                   Height="34"
                   Watermark="Layout" />
          <ComboBox ItemsSource="{Binding DockLayouts}"
                    SelectedItem="{Binding SelectedDockLayout}"
                    Width="132"
                    Height="34" />
          <Button Command="{Binding SaveDockLayoutCommand}" Padding="10,8">
            <TextBlock Text="Salvar" />
          </Button>
          <Button Command="{Binding LoadDockLayoutCommand}" Padding="10,8">
            <TextBlock Text="Carregar" />
          </Button>
          <Button Command="{Binding ResetDockLayoutCommand}" Padding="10,8">
            <TextBlock Text="Reset" />
          </Button>
        </StackPanel>

        <TextBox Grid.Column="2"
                 Watermark="Pesquisar jogos, tarefas e logs"
                 Text="{Binding LibrarySearchText, Mode=TwoWay}"
                 Height="36"
                 VerticalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   Text="Default"
                   Foreground="#C7CEDA"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="4"
                   Text="{Binding State}"
                   Foreground="#8EA0B8"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="232,5,*,5,300">
      <Border Grid.Column="0" Background="#151922" Padding="12">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top"
                     Text="Módulos"
                     Foreground="#8EA0B8"
                     FontWeight="SemiBold"
                     Margin="8,4,8,12" />
          <ListBox ItemsSource="{Binding Modules}"
                   SelectedItem="{Binding SelectedModule}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="dto:ShellModule">
                <Grid RowDefinitions="Auto,Auto" Margin="6" MinHeight="48">
                  <TextBlock Text="{Binding Title}" Foreground="#F6F8FC" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1"
                             Text="{Binding Description}"
                             Foreground="#8EA0B8"
                             FontSize="11"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="#242B36" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="22">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding SelectedModuleTitle}"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Foreground="#F6F8FC" />
          <TextBlock Text="{Binding SelectedModuleDescription}"
                     Foreground="#9BA8BA"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" Margin="0,22,0,0">
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
            <ItemsControl ItemsSource="{Binding DashboardWidgets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:DashboardWidgetViewModel">
                  <Border Background="#171C25" Padding="14" Margin="0,0,10,0">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                      <TextBlock Text="{Binding Title}"
                                 Foreground="#8EA0B8"
                                 FontWeight="SemiBold"
                                 FontSize="12" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Value}"
                                 Foreground="#F6F8FC"
                                 FontWeight="SemiBold"
                                 FontSize="22"
                                 Margin="0,6,0,0" />
                      <TextBlock Grid.Row="2"
                                 Text="{Binding Detail}"
                                 Foreground="#9BA8BA"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="10">
              <Border Background="#171C25" Padding="12">
                <Grid RowDefinitions="Auto,*">
                  <TextBlock Text="Atividades"
                             Foreground="#F6F8FC"
                             FontWeight="SemiBold" />
                  <ListBox Grid.Row="1"
                           ItemsSource="{Binding DashboardActivities}"
                           MaxHeight="98"
                           Background="Transparent"
                           BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="vm:DashboardActivityViewModel">
                        <Grid RowDefinitions="Auto,Auto" Margin="0,4">
                          <TextBlock Text="{Binding Title}"
                                     Foreground="#C7CEDA"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Row="1"
                                     Text="{Binding Detail}"
                                     Foreground="#8EA0B8"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="1" Background="#171C25" Padding="12">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Atalhos"
                               Foreground="#F6F8FC"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Command="{Binding RefreshDashboardCommand}"
                            Padding="8,4">
                      <TextBlock Text="Atualizar" />
                    </Button>
                  </Grid>
                  <ListBox Grid.Row="1"
                           ItemsSource="{Binding DashboardQuickActions}"
                           MaxHeight="98"
                           Background="Transparent"
                           BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="vm:DashboardQuickActionViewModel">
                        <Button Command="{Binding DataContext.RunDashboardQuickActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="8,5"
                                Margin="0,4,0,0">
                          <TextBlock Text="{Binding Title}" />
                        </Button>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Border Grid.Row="1" Background="#171C25" Padding="16" Margin="0,14,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="Biblioteca"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#F6F8FC" />
                <TextBlock Text="{Binding LibrarySummary}" Foreground="#9BA8BA" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding LibraryState}"
                         Foreground="#C7CEDA"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Column="2"
                        ItemsSource="{Binding LibraryViewModes}"
                        SelectedItem="{Binding SelectedLibraryViewMode}"
                        Width="132"
                        Height="34"
                        VerticalAlignment="Center" />
              <Button Grid.Column="3"
                      Command="{Binding RefreshLibraryCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      Padding="14,8"
                      VerticalAlignment="Center">
                <TextBlock Text="Atualizar" />
              </Button>
            </Grid>
          </Border>

          <Border Grid.Row="2" Background="#141820" Padding="12" Margin="0,14,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
              <TextBox Watermark="Filtrar por título, ID ou região"
                       Text="{Binding LibrarySearchText, Mode=TwoWay}"
                       Height="34" />
              <TextBlock Grid.Column="1"
                         Text="{Binding SelectionSummary}"
                         Foreground="#9BA8BA"
                         VerticalAlignment="Center" />
              <Button Grid.Column="2"
                      Command="{Binding ClearLibrarySearchCommand}"
                      Padding="12,7"
                      VerticalAlignment="Center">
                <TextBlock Text="Limpar" />
              </Button>
              <Button Grid.Column="3"
                      Command="{Binding RefreshDevicesCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      Padding="12,7"
                      VerticalAlignment="Center">
                <TextBlock Text="Dispositivos" />
              </Button>
              <Button Grid.Column="4"
                      Command="{Binding EjectSelectedDeviceCommand}"
                      Padding="12,7"
                      VerticalAlignment="Center">
                <TextBlock Text="Ejetar" />
              </Button>
            </Grid>
          </Border>

          <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="0,14,0,0" Background="#141820">
            <Border Background="#1A1F28" Padding="12,10">
              <Grid ColumnDefinitions="88,2*,120,110,100,90,90" ColumnSpacing="12">
                <TextBlock Text="ID" Foreground="#8EA0B8" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Título" Foreground="#8EA0B8" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Região" Foreground="#8EA0B8" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="Formato" Foreground="#8EA0B8" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="Tamanho" Foreground="#8EA0B8" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="Adicionado" Foreground="#8EA0B8" FontWeight="SemiBold" />
                <TextBlock Grid.Column="6" Text="Status" Foreground="#8EA0B8" FontWeight="SemiBold" />
              </Grid>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LibraryGameItem">
                  <Grid ColumnDefinitions="88,2*,120,110,100,90,90"
                        ColumnSpacing="12"
                        Margin="12,9"
                        MinHeight="34">
                    <TextBlock Text="{Binding Id}" Foreground="#C7CEDA" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               Foreground="#F6F8FC"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Region}" Foreground="#C7CEDA" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Format}" Foreground="#C7CEDA" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Size}" Foreground="#C7CEDA" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding AddedAt}" Foreground="#8EA0B8" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding Favorite}" Foreground="#7BD88F" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" Background="#242B36" ResizeDirection="Columns" IsVisible="{Binding IsSidePanelVisible}" />

      <Border Grid.Column="4"
              Background="#151922"
              Padding="16"
              IsVisible="{Binding IsSidePanelVisible}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="18">
          <StackPanel Spacing="4">
            <TextBlock Text="Tarefas" FontWeight="SemiBold" Foreground="#F6F8FC" />
            <TextBlock Text="{Binding TaskSummary}" Foreground="#9BA8BA" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Notificações" FontWeight="SemiBold" Foreground="#F6F8FC" />
            <TextBlock Text="{Binding NotificationSummary}" Foreground="#9BA8BA" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="Dispositivo" FontWeight="SemiBold" Foreground="#F6F8FC" />
            <TextBlock Text="{Binding DeviceManagerSummary}" Foreground="#9BA8BA" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="Layout" FontWeight="SemiBold" Foreground="#F6F8FC" />
            <TextBlock Text="{Binding DockLayoutSummary}" Foreground="#9BA8BA" TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="4" Background="#141820" Padding="12">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Importação"
                           FontWeight="SemiBold"
                           Foreground="#F6F8FC"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ImportWizardState}"
                           Foreground="#8EA0B8"
                           FontSize="11"
                           VerticalAlignment="Center" />
              </Grid>

              <ComboBox ItemsSource="{Binding ImportSteps}"
                        SelectedItem="{Binding SelectedImportStep}"
                        Height="32" />

              <TextBox Text="{Binding ImportSourcePathsText, Mode=TwoWay}"
                       Watermark="/jogos/mario.iso"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="70" />

              <ComboBox ItemsSource="{Binding Drives}"
                        SelectedItem="{Binding SelectedImportDrive}"
                        Height="32">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="domain:UsbDrive">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Command="{Binding AnalyzeImportCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="10,7">
                  <TextBlock Text="Analisar" />
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding ExecuteImportCommand}"
                        IsEnabled="{Binding CanExecuteImport}"
                        Padding="10,7">
                  <TextBlock Text="Importar" />
                </Button>
              </Grid>

              <Button Command="{Binding CancelImportCommand}"
                      Padding="10,7">
                <TextBlock Text="Cancelar" />
              </Button>

              <TextBlock Text="{Binding ImportSummary}"
                         Foreground="#9BA8BA"
                         TextWrapping="Wrap" />

              <ListBox ItemsSource="{Binding ImportPreviewItems}"
                       MaxHeight="120"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ImportPreviewItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="0,4">
                      <TextBlock Text="{Binding SourcePath}"
                                 Foreground="#F6F8FC"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Message}"
                                 Foreground="#8EA0B8"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border Grid.Row="5" Background="#141820" Padding="12">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Conversão"
                           FontWeight="SemiBold"
                           Foreground="#F6F8FC"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ConversionWizardState}"
                           Foreground="#8EA0B8"
                           FontSize="11"
                           VerticalAlignment="Center" />
              </Grid>

              <ComboBox ItemsSource="{Binding ConversionSteps}"
                        SelectedItem="{Binding SelectedConversionStep}"
                        Height="32" />

              <TextBox Text="{Binding ConversionSourcePathsText, Mode=TwoWay}"
                       Watermark="/jogos/mario.iso"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="58" />

              <TextBox Text="{Binding ConversionDestinationDirectory, Mode=TwoWay}"
                       Watermark="/jogos/convertidos"
                       Height="32" />

              <ComboBox ItemsSource="{Binding ConversionTargetFormats}"
                        SelectedItem="{Binding SelectedConversionTargetFormat}"
                        Height="32" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Command="{Binding AnalyzeConversionCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="10,7">
                  <TextBlock Text="Analisar" />
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding ExecuteConversionCommand}"
                        IsEnabled="{Binding CanExecuteConversion}"
                        Padding="10,7">
                  <TextBlock Text="Converter" />
                </Button>
              </Grid>

              <Button Command="{Binding CancelConversionCommand}"
                      Padding="10,7">
                <TextBlock Text="Cancelar" />
              </Button>

              <TextBlock Text="{Binding ConversionSummary}"
                         Foreground="#9BA8BA"
                         TextWrapping="Wrap" />

              <ListBox ItemsSource="{Binding ConversionPreviewItems}"
                       MaxHeight="110"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ConversionPreviewItemViewModel">
                    <Grid RowDefinitions="Auto,Auto" Margin="0,4">
                      <TextBlock Text="{Binding SourcePath}"
                                 Foreground="#F6F8FC"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Pipeline}"
                                 Foreground="#8EA0B8"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <ListBox Grid.Row="6"
                   ItemsSource="{Binding Devices}"
                   SelectedItem="{Binding SelectedDevice}"
                   Background="#141820"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:DeviceInfoViewModel">
                <Grid RowDefinitions="Auto,Auto,Auto" Margin="8" MinHeight="58">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" Foreground="#F6F8FC" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               Foreground="#8EA0B8"
                               FontSize="11" />
                  </Grid>
                  <TextBlock Grid.Row="1"
                             Text="{Binding MountPoint}"
                             Foreground="#8EA0B8"
                             TextTrimming="CharacterEllipsis" />
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <TextBlock Text="{Binding FileSystem}" Foreground="#C7CEDA" FontSize="11" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FreeSpace}"
                               Foreground="#C7CEDA"
                               FontSize="11" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#1A1F28" Padding="14,8">
      <Grid ColumnDefinitions="1.6*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18">
        <TextBlock Text="{Binding StatusMessage}" Foreground="#C7CEDA" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding StatusActiveDevice}" Foreground="#8EA0B8" />
        <TextBlock Grid.Column="2" Text="{Binding StatusFileSystem}" Foreground="#8EA0B8" />
        <TextBlock Grid.Column="3" Text="{Binding StatusFreeSpace}" Foreground="#8EA0B8" />
        <TextBlock Grid.Column="4" Text="{Binding SelectionSummary}" Foreground="#8EA0B8" />
        <TextBlock Grid.Column="5" Text="{Binding StatusTasks}" Foreground="#8EA0B8" />
        <TextBlock Grid.Column="6" Text="{Binding StatusNotifications}" Foreground="#8EA0B8" />
        <TextBlock Grid.Column="7" Text="{Binding StatusMemory}" Foreground="#8EA0B8" />
        <TextBlock Grid.Column="8" Text="{Binding StatusVersion}" Foreground="#8EA0B8" />
      </Grid>
    </Border>
  </Grid>
</Window>
